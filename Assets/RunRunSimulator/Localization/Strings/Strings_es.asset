      m_Items: []
  - m_Id: 4172480282720
    m_Localized: "\xBFQu\xE9 tendr\xE1n hoy?"
    m_Metadata:
      m_Items: []
  - m_Id: 4172480282721
    m_Localized: "A ver qu\xE9 me encuentro\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4172480282722
    m_Localized: Vengo a darme una vuelta.
    m_Metadata:
      m_Items: []
  - m_Id: 4172480282723
    m_Localized: Mmm, huele a criaturas nuevas.
    m_Metadata:
      m_Items: []
  - m_Id: 4172480282724
    m_Localized: "\xBFHabr\xE1 algo bonito?"
    m_Metadata:
      m_Items: []
  - m_Id: 4172480282725
    m_Localized: Vamos a chismear los estantes.
    m_Metadata:
      m_Items: []
  - m_Id: 4172480282726
    m_Localized: "Mmm, d\xE9jame ver\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4172480282727
    m_Localized: "\xBFSer\xE1 este el indicado?"
    m_Metadata:
      m_Items: []
  - m_Id: 4172480282728
    m_Localized: "Qu\xE9 ojitos tiene\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4172480282729
    m_Localized: "A ver, a ver\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4172480282730
    m_Localized: "No s\xE9, no s\xE9\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4172480282731
    m_Localized: "Interesante\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4172480282732
    m_Localized: "\xA1Me llevo a {0}!"
    m_Metadata:
      m_Items: []
  - m_Id: 4172480282733
    m_Localized: "\xA1{0} es perfecto!"
    m_Metadata:
      m_Items: []
  - m_Id: 4172480282734
    m_Localized: "\xA1Lo decid\xED: {0}!"
    m_Metadata:
      m_Items: []
  - m_Id: 4172480282735
    m_Localized: "\xA1A la caja con {0}!"
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476928
    m_Localized: "\xA1{0} se viene conmigo\u2026 si me alcanza!"
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476929
    m_Localized: "Esperar\xE9 mi turno\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476930
    m_Localized: "Uf, qu\xE9 fila."
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476931
    m_Localized: "Ah\xED voy, ah\xED voy."
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476932
    m_Localized: "Paciencia\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476933
    m_Localized: "\xBFFalta mucho?"
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476934
    m_Localized: "\xBFHay alguien en la caja?"
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476935
    m_Localized: "\xBFHola? \xBFAtienden?"
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476936
    m_Localized: "Tum, tum, tum\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476937
    m_Localized: "\xBFMe escuchan?"
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476938
    m_Localized: "Aqu\xED espero\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476939
    m_Localized: "\xBFCu\xE1nto por {0}?"
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476940
    m_Localized: "\xBFMe hace precio por {0}?"
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476941
    m_Localized: "\xBFLo deja m\xE1s barato?"
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476942
    m_Localized: "\xBFHacemos trato por {0}?"
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476943
    m_Localized: "Mmm\u2026 \xBFes negociable?"
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476944
    m_Localized: "\xA1{0} se viene conmigo!"
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476945
    m_Localized: "\xA1M\xEDo, m\xEDo! \xA1{0}!"
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476946
    m_Localized: "\xA1Qu\xE9 felicidad, {0}!"
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476947
    m_Localized: "\xA1Gracias! \xA1Cuidar\xE9 a {0}!"
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476948
    m_Localized: "\xA1{0} y yo seremos felices!"
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476949
    m_Localized: "\xA1Me ganaron a {0}!"
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476950
    m_Localized: "\xA1No! \xA1Quer\xEDa a {0}\u2026!"
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476951
    m_Localized: "Llegu\xE9 tarde por {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476952
    m_Localized: Ash, se llevaron a {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476953
    m_Localized: "\xA1{0} ya ten\xEDa due\xF1o! Qu\xE9 rabia."
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476954
    m_Localized: "\xA1Est\xE1 muy lleno!"
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476955
    m_Localized: "Uf, cu\xE1nta gente."
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476956
    m_Localized: Mejor vuelvo luego.
    m_Metadata:
      m_Items: []
  - m_Id: 4172484476957
    m_Localized: No aguanto esta multitud.
