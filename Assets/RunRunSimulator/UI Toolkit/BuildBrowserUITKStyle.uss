.browser-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: flex-end;
}

.browser-panel {
    width: 80%;
    max-width: 900px;
    max-height: 55%;
    margin-bottom: 175px;
    background-color: rgba(26, 26, 32, 0.96);
    border-width: 2px;
    border-color: rgb(120, 120, 130);
    border-radius: 10px;
    padding: 17px;
}

.browser-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 11px;
}

.browser-title {
    font-size: 28px;
    color: rgb(255, 214, 92);
    -unity-font-style: bold;
}

.browser-hint {
    font-size: 15px;
    color: rgba(200, 200, 210, 0.7);
}

.browser-tabs {
    flex-direction: row;
    margin-bottom: 11px;
}

.browser-tab {
    padding: 7px 20px;
    margin-right: 8px;
    background-color: rgba(40, 40, 48, 0.9);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    color: rgb(210, 210, 218);
    font-size: 18px;
}

.browser-tab--active {
    border-color: rgb(255, 214, 92);
    color: rgb(255, 214, 92);
    background-color: rgba(55, 50, 24, 0.95);
}

.browser-pieces {
    flex-grow: 1;
    min-height: 154px;
}

.browser-pieces > .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    padding: 4px;
}

.browser-piece {
    width: 134px;
    height: 134px;
    margin: 6px;
    background-color: rgba(40, 40, 48, 0.9);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: flex-end;
    color: rgb(235, 235, 240);
}

.browser-piece--selected {
    border-color: rgb(255, 214, 92);
    background-color: rgba(55, 50, 24, 0.95);
    scale: 1.06 1.06;
}

.browser-piece__name {
    width: 100%;
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: 14px;
    padding-bottom: 6px;
    color: rgb(235, 235, 240);
}

.browser-empty {
    color: rgba(200, 200, 210, 0.7);
    font-size: 18px;
    -unity-text-align: middle-center;
    padding: 22px;
}
