.browser-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: flex-end;
}

.browser-panel {
    width: 80%;
    max-width: 900px;
    margin-bottom: 110px;
    background-color: rgba(26, 26, 32, 0.96);
    border-width: 2px;
    border-color: rgb(120, 120, 130);
    border-radius: 10px;
    padding: 12px;
}

.browser-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.browser-title {
    font-size: 20px;
    color: rgb(255, 214, 92);
    -unity-font-style: bold;
}

.browser-hint {
    font-size: 11px;
    color: rgba(200, 200, 210, 0.7);
}

.browser-tabs {
    flex-direction: row;
    margin-bottom: 8px;
}

.browser-tab {
    padding: 5px 14px;
    margin-right: 6px;
    background-color: rgba(40, 40, 48, 0.9);
    border-radius: 6px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    color: rgb(210, 210, 218);
    font-size: 13px;
}

.browser-tab--active {
    border-color: rgb(255, 214, 92);
    color: rgb(255, 214, 92);
    background-color: rgba(55, 50, 24, 0.95);
}

.browser-pieces {
    min-height: 110px;
}

.browser-piece {
    width: 96px;
    height: 96px;
    margin: 4px;
    background-color: rgba(40, 40, 48, 0.9);
    border-radius: 6px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: flex-end;
    color: rgb(235, 235, 240);
}

.browser-piece--selected {
    border-color: rgb(255, 214, 92);
    background-color: rgba(55, 50, 24, 0.95);
    scale: 1.06 1.06;
}

.browser-piece__name {
    width: 100%;
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: 10px;
    padding-bottom: 4px;
    color: rgb(235, 235, 240);
}

.browser-empty {
    color: rgba(200, 200, 210, 0.7);
    font-size: 13px;
    -unity-text-align: middle-center;
    padding: 16px;
}
