.browser-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: flex-end;
}

.browser-panel {
    width: 80%;
    max-width: 900px;
    max-height: 55%;
    margin-bottom: 175px;
    background-color: var(--mm-surface);
    border-width: 2px;
    border-color: var(--mm-frame);
    border-radius: 10px;
    padding: 17px;
}

.browser-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 11px;
}

.browser-title {
    font-size: 28px;
    color: var(--mm-gold);
    -unity-font-style: bold;
}

.browser-hint {
    font-size: 15px;
    color: var(--mm-ink-soft);
}

.browser-tabs {
    flex-direction: row;
    margin-bottom: 11px;
}

.browser-tab {
    padding: 7px 20px;
    margin-right: 8px;
    background-color: var(--mm-surface-2);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    color: var(--mm-ink-soft);
    font-size: 18px;
}

.browser-tab--active {
    border-color: var(--mm-coral);
    color: var(--mm-coral);
    background-color: var(--mm-surface);
}

.browser-pieces {
    flex-grow: 1;
    min-height: 154px;
}

.browser-pieces > .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    padding: 4px;
}

.browser-piece {
    width: 134px;
    height: 134px;
    margin: 6px;
    background-color: var(--mm-surface-2);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: flex-end;
    color: var(--mm-ink);
}

.browser-piece--selected {
    border-color: var(--mm-coral);
    background-color: var(--mm-surface);
    scale: 1.06 1.06;
}

.browser-piece__name {
    width: 100%;
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: 14px;
    padding-bottom: 6px;
    color: var(--mm-ink);
}

.browser-empty {
    color: var(--mm-ink-soft);
    font-size: 18px;
    -unity-text-align: middle-center;
    padding: 22px;
}
