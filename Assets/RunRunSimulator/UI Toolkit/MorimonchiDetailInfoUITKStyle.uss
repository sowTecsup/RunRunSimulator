/* Detailed MoriMochi summary window (UI Toolkit), FireRed-summary inspired.
   - Full-screen modal backdrop that blocks the grid behind it.
   - Left column: portrait + colored stats. Right column: everything else. */

.detail-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.detail-window {
    width: 72%;
    height: 72%;
    padding: 14px;
    border-radius: 12px;
    background-color: rgb(28, 28, 38);
}

/* Header: title + close X. */
.detail-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

/* The name is the headline — big, fills the header width, and auto-shrinks only
   for unusually long names (bounded height lets best-fit work). */
.detail-title {
    flex-grow: 1;
    height: 56px;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 24px 46px;
    -unity-font-style: bold;
    color: rgb(235, 235, 240);
}

.detail-close {
    width: 36px;
    height: 36px;
    margin: 0;
    border-radius: 6px;
    -unity-font-style: bold;
    font-size: 18px;
    color: rgb(235, 235, 240);
    background-color: rgb(70, 70, 88);
}

.detail-close:hover {
    background-color: rgb(95, 95, 120);
}

.detail-tabs {
    flex-grow: 1;
}

/* ── TabView chrome ───────────────────────────────────────────────
   The native TabView ships a tiny, scrollable header (the left/right arrows in
   the default skin come from its internal ScrollView). We hide those scrollers
   and restyle the headers into proper pill buttons. */

/* Tab bar: a simple row, no scroll arrows. */
.detail-tabs > .unity-tab-view__header-container {
    flex-direction: row;
    flex-wrap: nowrap;
    background-color: rgb(22, 22, 30);
    border-radius: 8px;
    padding: 4px;
    margin-bottom: 10px;
}

/* Kill the header's left/right scroll arrows. The TabView makes its header a
   horizontal ScrollView and shows arrow buttons when it thinks the tabs overflow.
   Targeting the HORIZONTAL scroller removes them whatever the header class is,
   while leaving the Info page's VERTICAL scrollbar (a different scroller) intact. */
.detail-tabs .unity-scroller--horizontal {
    display: none;
}

/* Belt-and-suspenders: also hide any scroller/scroll-buttons inside the header. */
.detail-tabs .unity-tab-view__header-container .unity-scroller,
.detail-tabs .unity-tab-view__header-container .unity-scroller__low-button,
.detail-tabs .unity-tab-view__header-container .unity-scroller__high-button {
    display: none;
}

/* Each tab header = a pill button. */
.unity-tab__header {
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-right: 6px;
    border-radius: 6px;
    background-color: rgb(40, 40, 52);
}

.unity-tab__header:hover {
    background-color: rgb(58, 58, 76);
}

/* Selected tab: highlighted pill. */
.unity-tab__header:checked {
    background-color: rgb(96, 74, 150);
}

.unity-tab__header-label {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(225, 225, 232);
}

/* We signal selection with the pill color, so drop the default underline. */
.unity-tab__header-underline {
    display: none;
}

/* Make the page content fill the window height (so stats best-fit has room). */
.detail-tabs .unity-tab-view__content-container,
.detail-tabs .unity-tab__content-container {
    flex-grow: 1;
}

/* ── Info page ───────────────────────────────────────────────── */

.info-body {
    flex-direction: row;
    flex-grow: 1;
    padding-top: 8px;
}

.info-left {
    width: 34%;
    margin-right: 12px;
}

/* Portrait placeholder — tinted with PrimaryColor until real sprites exist.
   Tall enough to read as a square slot for the future sprite. */
.portrait {
    width: 100%;
    height: 300px;
    border-radius: 8px;
    margin-bottom: 12px;
    background-color: rgb(120, 120, 120);
}

.stats {
    flex-grow: 1;
    flex-direction: column;
}

/* Each stat is colored; the value reads "FINAL (base + bonus)". They share the
   column's height (flex-grow) and auto-size to fill it. */
.stat {
    flex-grow: 1;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 12px 34px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.stat--hp  { color: rgb(110, 220, 120); }
.stat--atk { color: rgb(235, 120, 100); }
.stat--spd { color: rgb(110, 190, 235); }

.info-right {
    flex-grow: 1;
}

.section-title {
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 16px 26px;
    -unity-font-style: bold;
    color: rgb(170, 170, 185);
    margin-top: 12px;
    margin-bottom: 4px;
}

.info-block {
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 16px 30px;
    color: rgb(225, 225, 230);
    white-space: normal;
    margin-bottom: 6px;
}

/* Parts — one row per slot: a set-colored swatch + its description. */
.parts {
    flex-direction: column;
}

.part-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.part-swatch {
    width: 22px;
    height: 22px;
    border-radius: 4px;
    margin-right: 8px;
}

.part-text {
    flex-grow: 1;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 14px 26px;
    color: rgb(225, 225, 230);
    white-space: normal;
}

/* Placeholder for the not-yet-built tabs. */
.placeholder {
    flex-grow: 1;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 14px 28px;
    color: rgb(150, 150, 165);
    -unity-text-align: middle-center;
}
