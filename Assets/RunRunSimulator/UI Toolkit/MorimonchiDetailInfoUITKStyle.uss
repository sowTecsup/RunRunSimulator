/* Detailed MoriMochi summary window (UI Toolkit), FireRed-summary inspired.
   - Full-screen modal backdrop that blocks the grid behind it.
   - Left column: portrait + colored stats. Right column: everything else. */

.detail-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--mm-scrim);
    align-items: center;
    justify-content: center;
}

.detail-window {
    width: 72%;
    height: 72%;
    padding: 14px;
    border-radius: 12px;
    background-color: var(--mm-surface);
}

/* Header: title + close X. */
.detail-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

/* The name is the headline — big, fills the header width, and auto-shrinks only
   for unusually long names (bounded height lets best-fit work). */
.detail-title {
    flex-grow: 1;
    height: 56px;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 24px 46px;
    -unity-font-style: bold;
    color: var(--mm-ink);
}

.detail-close {
    width: 36px;
    height: 36px;
    margin: 0;
    border-radius: 10px;
    border-width: 3px;
    border-color: var(--mm-frame);
    -unity-font-style: bold;
    font-size: 18px;
    color: var(--mm-ink);
    background-color: var(--mm-surface-2);
}

.detail-close:hover {
    background-color: var(--mm-coral);
    color: rgb(255, 255, 255);
}

.detail-tabs {
    flex-grow: 1;
}

/* ── TabView chrome ───────────────────────────────────────────────
   The native TabView ships a tiny, scrollable header (the left/right arrows in
   the default skin come from its internal ScrollView). We hide those scrollers
   and restyle the headers into proper pill buttons. */

/* Tab bar: a simple row, no scroll arrows. */
.detail-tabs > .unity-tab-view__header-container {
    flex-direction: row;
    flex-wrap: nowrap;
    background-color: var(--mm-surface-2);
    border-radius: 8px;
    padding: 4px;
    margin-bottom: 10px;
}

/* Kill the header's left/right scroll arrows. The TabView makes its header a
   horizontal ScrollView and shows arrow buttons when it thinks the tabs overflow.
   Targeting the HORIZONTAL scroller removes them whatever the header class is,
   while leaving the Info page's VERTICAL scrollbar (a different scroller) intact. */
.detail-tabs .unity-scroller--horizontal {
    display: none;
}

/* Belt-and-suspenders: also hide any scroller/scroll-buttons/arrows inside the
   header (the ◄ ► appear as repeat-buttons in some Unity versions). The tabs
   themselves are .unity-tab__header (not buttons), so they stay. */
.detail-tabs .unity-tab-view__header-container .unity-scroller,
.detail-tabs .unity-tab-view__header-container .unity-scroller__low-button,
.detail-tabs .unity-tab-view__header-container .unity-scroller__high-button,
.detail-tabs .unity-tab-view__header-container .unity-repeat-button,
.detail-tabs .unity-tab-view__header-container .unity-button {
    display: none;
}

/* Each tab header = a pill button. */
.unity-tab__header {
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-right: 6px;
    border-radius: 8px;
    background-color: var(--mm-surface);
}

.unity-tab__header:hover {
    background-color: var(--mm-surface-2);
}

/* Selected tab: highlighted pill. */
.unity-tab__header:checked {
    background-color: var(--mm-plum);
}

.unity-tab__header-label {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--mm-ink);
}

/* We signal selection with the pill color, so drop the default underline. */
.unity-tab__header-underline {
    display: none;
}

/* Make the page content fill the window height (so stats best-fit has room). */
.detail-tabs .unity-tab-view__content-container,
.detail-tabs .unity-tab__content-container {
    flex-grow: 1;
}

/* ── Info page ───────────────────────────────────────────────── */

.info-body {
    flex-direction: row;
    flex-grow: 1;
    padding-top: 8px;
}

.info-left {
    width: 34%;
    margin-right: 12px;
}

/* Portrait placeholder — tinted with PrimaryColor until real sprites exist.
   Tall enough to read as a square slot for the future sprite. */
.portrait {
    width: 100%;
    height: 300px;
    border-radius: 8px;
    margin-bottom: 12px;
    background-color: rgb(120, 120, 120);
}

.stats {
    flex-grow: 1;
    flex-direction: column;
}

/* Each stat is colored; the value reads "FINAL (base + bonus)". They share the
   column's height (flex-grow) and auto-size to fill it. */
.stat {
    flex-grow: 1;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 12px 34px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.stat--con { color: var(--mm-good); }
.stat--atk { color: var(--mm-crit); }
.stat--spd { color: var(--mm-teal); }
.stat--def { color: var(--mm-gold); }
.stat--lck { color: var(--mm-plum); }
.stat--eva { color: var(--mm-teal); }

.info-right {
    flex-grow: 1;
}

.section-title {
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 16px 26px;
    -unity-font-style: bold;
    color: var(--mm-ink-soft);
    margin-top: 12px;
    margin-bottom: 4px;
}

.info-block {
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 16px 30px;
    color: var(--mm-ink);
    white-space: normal;
    margin-bottom: 6px;
}

/* Parts — one row per slot: a set-colored swatch + its description. */
.parts {
    flex-direction: column;
}

.part-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.part-swatch {
    width: 22px;
    height: 22px;
    border-radius: 4px;
    margin-right: 8px;
}

.part-text {
    flex-grow: 1;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 14px 26px;
    color: var(--mm-ink);
    white-space: normal;
}

/* ── Combat tab: one card per finished fight, newest first ───────
   Turn-by-turn detail is not shown here — that replay lives in the
   Combat Visualizer. */
.combat-body { flex-grow: 1; padding-top: 8px; }
.combat-history { flex-grow: 1; }

.combat-card {
    margin-bottom: 8px;
    padding: 10px;
    border-radius: 10px;
    background-color: var(--mm-surface-2);
    border-left-width: 4px;
    border-left-color: var(--mm-frame-soft);
}

.combat-card--win  { border-left-color: var(--mm-good); }
.combat-card--lose { border-left-color: var(--mm-crit); }
.combat-card--draw { border-left-color: var(--mm-ink-soft); }

.combat-card__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.combat-card__badge {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--mm-ink);
}

.combat-card__badge--win  { color: var(--mm-good); }
.combat-card__badge--lose { color: var(--mm-crit); }
.combat-card__badge--draw { color: var(--mm-ink-soft); }

.combat-card__date {
    font-size: 12px;
    color: var(--mm-ink-soft);
}

.combat-card__opponent {
    font-size: 13px;
    color: var(--mm-ink);
    margin-top: 2px;
    margin-bottom: 6px;
}

.combat-card__body {
    flex-direction: row;
    margin-top: 2px;
}

.combat-card__colstats {
    flex-grow: 1;
    flex-direction: column;
}

.combat-card__colhead {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.combat-card__swatch {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background-color: rgb(90, 90, 100);
    margin-right: 6px;
}

.combat-card__col-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--mm-ink-soft);
}

.combat-card__stat {
    font-size: 12px;
    color: var(--mm-ink);
}

.combat-card__chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 3px;
}

.combat-card__tierchip {
    font-size: 11px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 1px;
    padding-bottom: 1px;
    border-radius: 8px;
    background-color: var(--mm-surface);
    color: var(--mm-gold);
    margin-right: 4px;
    margin-top: 2px;
}

.combat-card__nostats {
    font-size: 12px;
    -unity-font-style: italic;
    color: var(--mm-ink-soft);
    margin-top: 4px;
}

.combat-card__comment {
    font-size: 12px;
    -unity-font-style: italic;
    color: var(--mm-ink-soft);
    margin-top: 6px;
}

.combat-card__footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 4px;
}

.combat-card__play {
    width: 32px;
    height: 24px;
    margin: 0;
    padding: 0;
    border-radius: 8px;
    font-size: 12px;
    color: var(--mm-ink);
    background-color: var(--mm-surface-2);
}

.combat-card__play:hover {
    background-color: var(--mm-coral);
    color: rgb(255, 255, 255);
}

.combat-card__play:disabled {
    opacity: 0.4;
}

/* ── Lineage tab: ancestor tree (self + parents + grandparents) ─── */
.lineage-body { flex-grow: 1; }
.lineage-tree { align-items: center; padding: 12px; }

/* A generation block stacks: [ancestors row] → [connector] → [this chip]. */
.tree-block { align-items: center; }
.tree-parents { flex-direction: row; justify-content: center; align-items: flex-end; }
/* Downward direction (Breed tab): children hang below their parent. */
.tree-children { flex-direction: row; justify-content: center; align-items: flex-start; }
.tree-branch { align-items: center; margin-left: 10px; margin-right: 10px; }
.tree-partner { align-items: center; margin-left: 14px; margin-right: 14px; }
.tree-chip--partner { border-color: var(--mm-plum); }

/* One creature chip: color swatch header + name. */
.tree-chip {
    width: 104px;
    align-items: center;
    padding: 6px;
    border-radius: 8px;
    background-color: var(--mm-surface-2);
    border-width: 2px; border-color: var(--mm-frame-soft);
}
.tree-chip--self    { border-color: var(--mm-plum); }
.tree-chip--unknown { background-color: var(--mm-surface); border-color: var(--mm-frame-soft); }
.tree-swatch { width: 56px; height: 56px; border-radius: 6px; background-color: rgb(90, 90, 100); margin-bottom: 4px; }
.tree-name {
    width: 100%; font-size: 12px; -unity-font-style: bold; color: var(--mm-ink);
    -unity-text-align: middle-center;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.tree-role { font-size: 10px; color: var(--mm-ink-soft); -unity-text-align: middle-center; }
.tree-dead .tree-name { color: var(--mm-crit); }

/* Simple connectors between generations. */
.tree-connector-v { width: 2px; height: 14px; background-color: var(--mm-frame-soft); }
.tree-connector-h { height: 2px; background-color: var(--mm-frame-soft); }

/* Placeholder for the not-yet-built tabs. */
.placeholder {
    flex-grow: 1;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 14px 28px;
    color: var(--mm-ink-soft);
    -unity-text-align: middle-center;
}

/* ── Equipo tab: minimalist (left = item cards, right = portrait + stats) ── */
.equip-body {
    flex-direction: row;
    flex-grow: 1;
    padding-top: 8px;
}

/* Left column: one card per equipment slot. */
.equip-cards {
    width: 56%;
    margin-right: 12px;
}

.equip-card {
    flex-direction: row;
    background-color: var(--mm-surface-2);
    border-radius: 10px;
    border-left-width: 4px;
    border-left-color: var(--mm-frame-soft);
    padding: 10px;
    margin-bottom: 8px;
    overflow: hidden;
}

/* Right-side diagonal accent, painted in code (Painter2D) with the rarity color.
   Reserved space for equipment effects (next session). */
.equip-card__diag {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.equip-card--empty {
    background-color: var(--mm-surface);
    opacity: 0.7;
}

.equip-card__icon {
    width: 64px;
    height: 64px;
    border-radius: 8px;
    margin-right: 10px;
    background-color: var(--mm-surface);
    -unity-background-scale-mode: scale-to-fit;
}

.equip-card__info {
    flex-grow: 1;
    flex-direction: column;
}

.equip-card__name {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--mm-ink);
    white-space: normal;
}

.equip-card__meta {
    font-size: 12px;
    color: var(--mm-ink-soft);
    margin-bottom: 4px;
}

.equip-card__desc {
    font-size: 13px;
    color: var(--mm-ink);
    white-space: normal;
    margin-bottom: 3px;
}

.equip-card__effects {
    font-size: 13px;
    color: var(--mm-good);
    white-space: normal;
}

.equip-card__procs {
    width: 40%;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    padding-left: 8px;
}

.equip-card__mods {
    font-size: 13px;
    color: var(--mm-gold);
    white-space: normal;
    -unity-text-align: middle-right;
}

/* Right column: big MoriMochi image + stats breakdown. */
.equip-right {
    width: 42%;
    flex-direction: column;
}

.equip-portrait {
    width: 100%;
    height: 240px;
    border-radius: 8px;
    margin-bottom: 8px;
    background-color: rgb(120, 120, 120);
}

.equip-stats {
    flex-direction: column;
}

.equip-stat {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 3px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: var(--mm-frame-soft);
}

.equip-stat__name {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--mm-ink-soft);
}

.equip-stat__val {
    font-size: 14px;
    color: var(--mm-ink);
}

.equip-stat__val--up   { color: var(--mm-good); }
.equip-stat__val--down { color: var(--mm-crit); }
