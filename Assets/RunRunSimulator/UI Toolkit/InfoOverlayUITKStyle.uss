/* Full-screen, non-interactive layer. Children pin themselves to the corners. */
.overlay-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* Control legend, top-left. */
.overlay-hints {
    position: absolute;
    top: 24px;             /* 16 × 1.5 */
    left: 24px;            /* 16 × 1.5 */
    background-color: var(--mm-scrim);
    border-radius: 12px;   /* 8 × 1.5 */
    padding: 12px 15px;    /* 8×10 × 1.5 */
}

.hint-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;    /* 3 × 1.5 */
}

.hint-key {
    min-width: 81px;       /* 54 × 1.5 */
    font-size: 18px;       /* 12 × 1.5 */
    color: var(--mm-gold);
    -unity-font-style: bold;
    background-color: var(--mm-scrim);
    border-radius: 6px;    /* 4 × 1.5 */
    padding: 2px 9px;      /* 1×6 × 1.5 */
    margin-right: 12px;    /* 8 × 1.5 */
    -unity-text-align: middle-center;
}

.hint-action {
    font-size: 18px;       /* 12 × 1.5 */
    color: var(--mm-ink);
}

/* Language switch row, bottom of the legend. */
.lang-row {
    flex-direction: row;
    justify-content: flex-start;
    margin-top: 9px;
}

.lang-btn {
    min-width: 48px;
    font-size: 16px;
    color: var(--mm-ink);
    -unity-font-style: bold;
    background-color: var(--mm-scrim);
    border-radius: 6px;
    border-width: 0;
    padding: 3px 9px;
    margin-right: 8px;
}

.lang-btn--active {
    color: var(--mm-gold);
    border-width: 2px;
    border-color: var(--mm-gold);
}

/* Date + currency column, top-right. */
.overlay-top-right {
    position: absolute;
    top: 24px;             /* 16 × 1.5 */
    right: 24px;           /* 16 × 1.5 */
    align-items: flex-end;
}

.overlay-date {
    font-size: 24px;       /* 16 × 1.5 */
    color: var(--mm-gold);
    -unity-font-style: bold;
    background-color: var(--mm-scrim);
    border-radius: 12px;   /* 8 × 1.5 */
    padding: 9px 18px;     /* 6×12 × 1.5 */
    margin-bottom: 8px;
}

.overlay-dabloons {
    font-size: 21px;       /* 14 × 1.5 */
    color: var(--mm-gold);
    -unity-font-style: bold;
    background-color: var(--mm-scrim);
    border-radius: 12px;   /* 8 × 1.5 */
    padding: 7px 18px;
}
