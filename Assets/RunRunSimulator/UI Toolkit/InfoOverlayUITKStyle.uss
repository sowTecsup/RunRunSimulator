/* Full-screen, non-interactive layer. Children pin themselves to the corners. */
.overlay-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* Control legend, top-left. */
.overlay-hints {
    position: absolute;
    top: 24px;             /* 16 × 1.5 */
    left: 24px;            /* 16 × 1.5 */
    background-color: rgba(26, 26, 32, 0.55);
    border-radius: 12px;   /* 8 × 1.5 */
    padding: 12px 15px;    /* 8×10 × 1.5 */
}

.hint-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;    /* 3 × 1.5 */
}

.hint-key {
    min-width: 81px;       /* 54 × 1.5 */
    font-size: 18px;       /* 12 × 1.5 */
    color: rgb(255, 214, 92);
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.35);
    border-radius: 6px;    /* 4 × 1.5 */
    padding: 2px 9px;      /* 1×6 × 1.5 */
    margin-right: 12px;    /* 8 × 1.5 */
    -unity-text-align: middle-center;
}

.hint-action {
    font-size: 18px;       /* 12 × 1.5 */
    color: rgb(225, 225, 232);
}

/* Current date, top-right. */
.overlay-date {
    position: absolute;
    top: 24px;             /* 16 × 1.5 */
    right: 24px;           /* 16 × 1.5 */
    font-size: 24px;       /* 16 × 1.5 */
    color: rgb(255, 214, 92);
    -unity-font-style: bold;
    background-color: rgba(26, 26, 32, 0.55);
    border-radius: 12px;   /* 8 × 1.5 */
    padding: 9px 18px;     /* 6×12 × 1.5 */
}
