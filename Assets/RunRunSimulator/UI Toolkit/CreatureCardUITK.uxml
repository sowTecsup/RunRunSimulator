<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="CreatureGridUITKStyle.uss" />
    <!-- Template for ONE MoriMochi card. The controller clones this per creature
         and fills it via Q<>() by name. Mirror of the CreatureVisualUI prefab,
         but as a VisualTreeAsset instead of a GameObject prefab. -->
    <ui:VisualElement name="card" class="card">
        <ui:Label name="name-label" text="Name" class="card__name" />
        <ui:VisualElement name="icon" class="card__icon" />
        <ui:Label name="state-label" text="Free" class="card__state" />
        <ui:VisualElement name="equip-row" class="card__equip-row">
            <ui:VisualElement name="equip-weapon" class="card__equip-slot" />
            <ui:VisualElement name="equip-armor" class="card__equip-slot" />
            <ui:VisualElement name="equip-amulet" class="card__equip-slot" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
