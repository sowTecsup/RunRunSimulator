.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0.5;
}

.hud--idle .hud-board {
    display: none;
}

.hud--idle .hud-rival-team {
    display: none;
}

.hud--idle .hud-player-team {
    display: none;
}

.hud--idle .hud-result {
    display: none;
}

.hud--idle .hud-speed {
    display: none;
}

.hud-topleft {
    position: absolute;
    top: 14px;
    left: 16px;
    flex-direction: row;
    align-items: center;
}

.hud-btn {
    width: 40px;
    height: 40px;
    margin: 0;
    padding: 0;
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--mm-frame-soft);
    background-color: rgba(22, 15, 14, 0.86);
    color: var(--mm-ink);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hud-btn--dim {
    opacity: 0.5;
}

.hud-btn--speed {
    position: absolute;
    bottom: 14px;
    left: 16px;
    width: auto;
    min-width: 64px;
    padding: 0 10px;
}

.hud-palettes {
    position: absolute;
    top: 62px;
    left: 16px;
    flex-direction: row;
}

.hud-palette-btn {
    height: 26px;
    width: auto;
    margin: 0;
    margin-right: 6px;
    padding: 0 10px;
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--mm-frame-soft);
    background-color: rgba(22, 15, 14, 0.86);
    color: var(--mm-ink);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    opacity: 0.5;
}

.hud-palette-btn--on {
    border-color: var(--mm-frame);
    opacity: 1;
}

.hud-seed {
    font-size: 14px;
    letter-spacing: 1px;
    color: var(--mm-ink-soft);
    -unity-font-style: bold;
    margin-left: 10px;
}

.hud-board {
    position: absolute;
    top: 12px;
    left: 50%;
    translate: -50% 0;
    align-items: center;
    padding: 6px 18px 8px 18px;
    border-radius: 14px;
    border-width: 2px;
    border-color: var(--mm-frame-soft);
    background-color: rgba(22, 15, 14, 0.82);
}

.hud-board__row {
    flex-direction: row;
    align-items: center;
}

.hud-board__side {
    align-items: center;
    min-width: 104px;
}

.hud-score {
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    min-width: 52px;
}

.hud-carry {
    font-size: 13px;
    color: var(--mm-ink-soft);
    -unity-text-align: middle-center;
    margin-top: -4px;
}

.hud-carry--some {
    color: var(--mm-gold);
    -unity-font-style: bold;
}

.hud-score--player {
    color: var(--mm-ally);
}

.hud-score--rival {
    color: var(--mm-foe);
}

.hud-time {
    font-size: 36px;
    -unity-font-style: bold;
    color: var(--mm-ink);
    margin: 0 24px;
    -unity-text-align: middle-center;
}

.hud-time--warn {
    color: var(--mm-crit);
}

.hud-bar {
    width: 220px;
    height: 7px;
    margin-top: 4px;
    border-radius: 4px;
    background-color: rgba(122, 90, 70, 0.45);
    overflow: hidden;
}

.hud-bar__fill {
    height: 100%;
    width: 100%;
    border-radius: 4px;
    background-color: var(--mm-gold);
}

.hud-bar__fill--warn {
    background-color: var(--mm-crit);
}

.hud-rival-team {
    position: absolute;
    top: 14px;
    right: 16px;
    flex-direction: column;
    align-items: flex-end;
}

.hud-chip-rival {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 6px;
    padding: 6px 10px;
    border-radius: 10px;
    background-color: rgba(22, 15, 14, 0.78);
    border-width: 0;
    border-right-width: 3px;
    border-right-color: var(--mm-foe);
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    min-width: 172px;
    transition-property: background-color, border-color, translate;
    transition-duration: 0.15s;
}

.hud-chip-rival--chase {
    background-color: rgba(84, 46, 10, 0.86);
    border-right-color: rgb(255, 150, 40);
}

.hud-chip-rival--chase .hud-chip-rival__action {
    color: rgb(255, 176, 74);
}

.hud-chip-rival--selected {
    border-left-color: var(--mm-gold);
    translate: -6px 0;
}

.hud-chip-rival__swatch {
    width: 16px;
    height: 16px;
    border-radius: 5px;
    border-width: 1px;
    border-color: var(--mm-frame-soft);
    margin-right: 8px;
}

.hud-chip-rival__text {
    flex-grow: 1;
}

.hud-chip-rival__name {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--mm-ink);
}

.hud-chip-rival__archetype {
    font-size: 13px;
    color: var(--mm-gold);
}

.hud-chip-rival__action {
    font-size: 13px;
    color: var(--mm-ink-soft);
}

.hud-player-team {
    position: absolute;
    bottom: 14px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
}

.hud-card {
    width: 272px;
    margin: 0 6px;
    padding: 8px 10px;
    border-radius: 14px;
    border-width: 2px;
    border-color: var(--mm-frame-soft);
    border-top-width: 4px;
    background-color: rgba(22, 15, 14, 0.86);
    transition-property: translate, border-color, background-color;
    transition-duration: 0.15s;
}

.hud-card--chase {
    border-color: rgb(255, 150, 40);
    background-color: rgba(84, 46, 10, 0.88);
}

.hud-card--chase .hud-card__action {
    color: rgb(255, 176, 74);
}

.hud-card--hit {
    border-color: var(--mm-coral);
}

.hud-card--dazed {
    opacity: 0.4;
}

.hud-card--selected {
    border-color: var(--mm-gold);
    translate: 0 -10px;
}

.hud-card__header {
    flex-direction: row;
    align-items: center;
}

.hud-card__swatch {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--mm-frame-soft);
    margin-right: 8px;
}

.hud-card__text {
    flex-grow: 1;
}

.hud-card__name {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--mm-ink);
}

.hud-card__posture {
    font-size: 13px;
    color: var(--mm-gold);
}

.hud-card__pillars {
    flex-direction: row;
    margin-top: 6px;
}

.hud-chip {
    font-size: 13px;
    color: var(--mm-ink-soft);
    border-radius: 6px;
    border-width: 1px;
    padding: 2px 7px;
    margin-right: 4px;
    background-color: rgba(255, 255, 255, 0.08);
    -unity-text-align: middle-center;
}

.hud-chip--loot {
    border-color: var(--mm-teal);
}

.hud-chip--contact {
    border-color: var(--mm-coral);
}

.hud-chip--team {
    border-color: var(--mm-plum);
}

.hud-card__action {
    font-size: 14px;
    color: var(--mm-ink);
    margin-top: 6px;
}

.hud-card__carry {
    flex-direction: row;
    margin-top: 6px;
}

.hud-slot {
    width: 16px;
    height: 16px;
    margin-right: 3px;
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--mm-frame-soft);
    background-color: rgba(255, 255, 255, 0.08);
    overflow: hidden;
}

.hud-slot--full {
    background-color: var(--mm-gold);
}

.hud-slot__fill {
    height: 100%;
    width: 0;
    background-color: var(--mm-teal);
}

.hud-card__powers {
    flex-direction: row;
    margin-top: 8px;
    justify-content: space-between;
}

.hud-power {
    width: 78px;
    align-items: center;
    transition-property: scale, opacity;
    transition-duration: 0.18s;
}

.hud-power--dim {
    opacity: 0.35;
}

.hud-power--empty {
    opacity: 0.25;
}

.hud-power--passive .hud-power__label {
    -unity-font-style: italic;
}

.hud-power__radial {
    width: 44px;
    height: 44px;
    transition-property: scale;
    transition-duration: 0.18s;
}

.hud-power__radial.radial--fired {
    scale: 1.25 1.25;
}

.hud-power__label {
    font-size: 12px;
    color: var(--mm-ink);
    margin-top: 3px;
    -unity-text-align: middle-center;
}

.hud-result {
    position: absolute;
    top: 40%;
    left: 50%;
    translate: -50% 0;
    display: none;
    font-size: 34px;
    -unity-font-style: bold;
    padding: 10px 28px;
    border-radius: 14px;
    border-width: 2px;
    border-color: var(--mm-frame-soft);
    background-color: rgba(22, 15, 14, 0.9);
    color: var(--mm-ink);
}

.hud-result--show {
    display: flex;
}

.hud-result--win {
    color: var(--mm-ally);
}

.hud-result--lose {
    color: var(--mm-foe);
}

.hud-result--draw {
    color: var(--mm-ink-soft);
}
