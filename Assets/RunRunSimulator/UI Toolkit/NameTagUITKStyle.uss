/* Floating world-space name tag above a MoriMochi (UI Toolkit, world-space panel).
   Sizes are in panel px; WorldUIPanelSettings maps 100 px = 1 world unit, so a 30px
   font ≈ 0.3 world units tall. Tune the font sizes here if the tag reads too big/small. */

/* The card hugs its content (no fixed width) so short names don't get a huge box.
   align-self keeps it centered even though the panel root centers it too. */
.tag {
    align-items: center;
    align-self: center;
    padding: 6px 12px;
    background-color: rgba(20, 20, 28, 0.82);
    border-radius: 10px;
}

.tag__name {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(235, 235, 240);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* Store layout: the sale price under the name, shown from code only while the
   creature is displayed in a StoreContainer. Hidden by default. */
.tag__price {
    display: none;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 214, 120);
    -unity-text-align: middle-center;
    white-space: nowrap;
    margin-top: 2px;
}

/* Color is set from code per status (busy/dead); empty text hides the line. */
.tag__status {
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* What the MoriMochi wants to do right now — soft blue accent so it reads as a
   separate "thought" line under the name/status. */
.tag__intent {
    font-size: 20px;
    color: rgb(150, 200, 235);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* Pen layout (gender glyph / role / heart / timer) — hidden by default, shown
   from code only while the creature is penned (BreedingContainer). Color of the gender
   glyph is set per-gender from code. */
.tag__gender {
    display: none;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.tag__role {
    display: none;
    font-size: 20px;
    color: rgb(200, 200, 210);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.tag__stage {
    display: none;
    font-size: 18px;
    color: rgb(180, 200, 180);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.tag__breed {
    display: none;
    font-size: 20px;
    color: rgb(150, 235, 170);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.tag__heart {
    display: none;
    font-size: 26px;
    color: rgb(235, 70, 90);
    -unity-text-align: middle-center;
    white-space: nowrap;
    margin-top: 2px;
}

.tag__timer {
    display: none;
    font-size: 20px;
    color: rgb(255, 190, 210);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* Contextual pet hint — hidden by default, shown from code when the creature is
   in a friendly reaction and the player can interact with E. */
.tag__pet-hint {
    display: none;
    font-size: 18px;
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    margin-top: 4px;
}
