<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Theme.uss" />
    <Style src="MorimonchiDetailInfoUITKStyle.uss" />
    <!-- Full-screen backdrop sits above the grid (higher sortingOrder) and eats
         clicks, so the panel behind can't be touched until the X closes this.
         The window is centered inside it. -->
    <ui:VisualElement name="backdrop" class="mm-theme detail-backdrop">
        <ui:VisualElement name="window" class="detail-window">

            <ui:VisualElement name="detail-header" class="detail-header">
                <ui:Label name="title" text="MoriMochi" class="detail-title" />
                <ui:Button name="close-button" text="X" class="detail-close" />
            </ui:VisualElement>

            <ui:TabView name="tabs" class="detail-tabs">

                <!-- Summary page (FireRed-inspired): portrait + stats on the left,
                     all the rest on the right. -->
                <ui:Tab label="Info" name="tab-info">
                    <ui:VisualElement class="info-body">

                        <ui:VisualElement class="info-left">
                            <ui:VisualElement name="portrait" class="portrait" />
                            <ui:Label name="care-title" text="Cuidado" class="care-title" />
                            <ui:VisualElement name="needs" class="needs">
                                <ui:VisualElement name="need-health" class="detail-need">
                                    <ui:Label name="need-health-label" text="Vida" class="detail-need__label" />
                                    <ui:VisualElement class="detail-need__bar-track">
                                        <ui:VisualElement name="need-health-fill" class="detail-need__bar-fill" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="need-energy" class="detail-need">
                                    <ui:Label name="need-energy-label" text="Energía" class="detail-need__label" />
                                    <ui:VisualElement class="detail-need__bar-track">
                                        <ui:VisualElement name="need-energy-fill" class="detail-need__bar-fill" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="need-affect" class="detail-need">
                                    <ui:Label name="need-affect-label" text="Afecto" class="detail-need__label" />
                                    <ui:VisualElement class="detail-need__bar-track">
                                        <ui:VisualElement name="need-affect-fill" class="detail-need__bar-fill" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:Label name="explore-status" text="Apta para bajar" class="explore-status" />
                        </ui:VisualElement>

                        <ui:ScrollView name="info-right" class="info-right" mode="Vertical">
                            <ui:Label text="Identidad" class="section-title" />
                            <ui:Label name="identity" class="info-block" />
                            <ui:Label text="Rol y Elemento" class="section-title" />
                            <ui:Label name="role-element" class="info-block" />
                            <ui:Label text="Partes" class="section-title" />
                            <ui:VisualElement name="parts" class="parts" />
                            <ui:Label text="Progresión" class="section-title" />
                            <ui:Label name="progression" class="info-block" />
                        </ui:ScrollView>

                    </ui:VisualElement>
                </ui:Tab>

                <!-- Partners this MoriMochi bred with + the children from each. -->
                <ui:Tab label="Breed" name="tab-breed">
                    <ui:ScrollView class="lineage-body" mode="VerticalAndHorizontal">
                        <ui:VisualElement name="breed-tree" class="lineage-tree" />
                        <ui:Label name="breed-empty" text="Sin descendencia registrada." class="placeholder" />
                    </ui:ScrollView>
                </ui:Tab>

                <!-- Family tree: ancestors (self + parents + grandparents). -->
                <ui:Tab label="Linaje" name="tab-lineage">
                    <ui:ScrollView class="lineage-body" mode="VerticalAndHorizontal">
                        <ui:VisualElement name="lineage-tree" class="lineage-tree" />
                        <ui:Label name="lineage-empty" text="Sin ascendencia registrada (linaje silvestre)." class="placeholder" />
                    </ui:ScrollView>
                </ui:Tab>

                <!-- Social relations: who this MoriMochi likes and dislikes, read
                     straight from SocialGraphService (seed + history). -->
                <ui:Tab label="Relaciones" name="tab-relations">
                    <ui:ScrollView class="relations-body" mode="Vertical">
                        <ui:Label text="Le caen bien" class="section-title" />
                        <ui:VisualElement name="relations-good" class="relations-list" />
                        <ui:Label text="Le caen mal" class="section-title" />
                        <ui:VisualElement name="relations-bad" class="relations-list" />
                        <ui:Label name="relations-empty" text="Todavía no conoce a nadie." class="placeholder" />
                    </ui:ScrollView>
                </ui:Tab>

            </ui:TabView>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
