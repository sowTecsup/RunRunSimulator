<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Theme.uss" />
    <Style src="BuildBrowserUITKStyle.uss" />
    <!-- Furniture browser, shown only in build mode (Tab toggles). Standalone — NOT
         a UIManager panel, so opening it does NOT raise OnUIFocusChanged (which would
         exit build mode). The controller (BuildBrowserUITK) fills "tabs" with one tab
         per FurnitureCategory and "pieces" with the owned pieces in the active tab. -->
    <ui:VisualElement name="root" class="mm-theme browser-root">
        <ui:VisualElement name="panel" class="browser-panel">
            <ui:VisualElement name="header" class="browser-header">
                <ui:Label text="Construcción" class="browser-title" />
                <ui:Label text="↑↓ categoría · ←→ pieza · Enter coloca · Tab cierra" class="browser-hint" />
            </ui:VisualElement>
            <ui:VisualElement name="tabs" class="browser-tabs" />
            <ui:ScrollView name="pieces" class="browser-pieces" mode="Vertical" />
            <ui:Label name="empty" text="No tienes muebles en esta categoría." class="browser-empty" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
