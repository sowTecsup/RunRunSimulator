.rps {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.rps-panel {
    width: 960px;
    max-width: 94%;
    border-width: 3px;
    border-color: var(--mm-frame);
    border-radius: 22px;
}

.rps-panel .panel__header {
    border-top-left-radius: 19px;
    border-top-right-radius: 19px;
}

.rps-view {
    display: none;
}

.rps-view--active {
    display: flex;
}

.rps-subtitle {
    font-size: 14px;
    color: var(--mm-ink-soft);
    letter-spacing: 2px;
    margin: 14px 16px 6px 16px;
}

.rps-pick-list {
    height: 250px;
    margin: 0 10px;
}

.rps-pick-list .unity-scroll-view__content-container {
    flex-direction: row;
}

.rps-card {
    width: 150px;
    height: 220px;
    margin: 6px;
    padding: 5px;
    border-radius: 14px;
    background-color: var(--mm-surface-2);
    align-items: center;
    border-width: 3px;
    border-color: var(--mm-frame-soft);
}

.rps-card:hover {
    border-color: var(--mm-coral);
}

.rps-card--selected {
    border-color: var(--mm-coral);
    background-color: var(--mm-bg-deep);
}

.rps-card--off {
    opacity: 0.45;
}

.rps-card__icon {
    height: 60%;
    width: 80%;
    border-radius: 8px;
    border-width: 2px;
    border-color: var(--mm-frame-soft);
    background-color: rgb(120, 120, 120);
}

.rps-card__name {
    height: 20%;
    width: 100%;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 8px 20px;
    -unity-font-style: bold;
    color: var(--mm-ink);
    -unity-text-align: middle-center;
    white-space: normal;
}

.rps-card__state {
    height: 20%;
    width: 100%;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 8px 18px;
    color: var(--mm-gold);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.rps-card--off .rps-card__state {
    color: var(--mm-ink-soft);
    -unity-font-style: normal;
}

.rps-actions {
    padding-top: 12px;
}

.rps-duel {
    flex-direction: row;
    padding: 16px 12px 18px 12px;
    min-height: 380px;
}

.rps-side {
    flex-basis: 0;
    flex-grow: 1;
    align-items: center;
    padding: 6px;
}

.rps-side--rival {
    opacity: 0.92;
}

.rps-clash {
    flex-basis: 0;
    flex-grow: 1.35;
    align-items: center;
    justify-content: center;
    padding: 0 10px;
}

.rps-portrait {
    width: 104px;
    height: 104px;
    border-radius: 18px;
    border-width: 3px;
    border-color: var(--mm-frame);
}

.rps-name {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--mm-ink);
    margin-top: 8px;
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}

.rps-row-title {
    font-size: 11px;
    color: var(--mm-ink-soft);
    letter-spacing: 2px;
    margin-top: 10px;
    margin-bottom: 4px;
}

.rps-row {
    flex-direction: row;
    justify-content: center;
}

.rps-power {
    width: 66px;
    margin: 0 3px;
    padding: 4px 2px;
    border-radius: 8px;
    background-color: var(--mm-surface-2);
    border-width: 2px;
    border-color: var(--mm-frame-soft);
    align-items: center;
}

.rps-power__type {
    font-size: 10px;
    color: var(--mm-ink-soft);
    -unity-text-align: middle-center;
}

.rps-power__value {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--mm-gold);
}

.rps-intact {
    font-size: 13px;
    color: var(--mm-ink);
    margin: 0 5px;
    -unity-font-style: bold;
}

.rps-intact--none {
    color: var(--mm-crit);
    -unity-font-style: normal;
}

.rps-pip {
    width: 20px;
    height: 20px;
    margin: 2px 4px;
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--mm-frame);
    background-color: var(--mm-surface-2);
}

.rps-pip--hit {
    background-color: var(--mm-coral);
    border-color: var(--mm-coral-dark);
}

.rps-log {
    font-size: 16px;
    color: var(--mm-ink-soft);
    -unity-text-align: middle-center;
    white-space: normal;
    min-height: 48px;
    margin-bottom: 14px;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 16px;
}

.rps-hand {
    flex-direction: row;
    justify-content: center;
}

.rps-action {
    width: 118px;
    height: 58px;
    margin: 0 6px;
    border-radius: 10px;
    border-width: 3px;
    background-color: var(--mm-surface-2);
    color: var(--mm-ink);
    font-size: 18px;
    -unity-font-style: bold;
}

.rps-action:hover {
    background-color: var(--mm-bg-deep);
}

.rps-action--horns {
    border-color: var(--mm-teal);
}

.rps-action--wings {
    border-color: var(--mm-plum);
}

.rps-action--back {
    border-color: var(--mm-gold);
}

.rps-action--selected {
    background-color: var(--mm-frame-soft);
}

.rps-action:disabled {
    opacity: 0.40;
}

.rps-result {
    margin: 22px 16px 6px 16px;
    padding: 20px;
    border-radius: 16px;
    background-color: var(--mm-surface-2);
    border-width: 3px;
    border-color: var(--mm-frame-soft);
    align-items: center;
}

.rps-result--win {
    border-color: var(--mm-good);
}

.rps-result--lose {
    border-color: var(--mm-crit);
}

.rps-result-title {
    font-size: 30px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: var(--mm-ink);
}

.rps-result--win .rps-result-title {
    color: var(--mm-good);
}

.rps-result--lose .rps-result-title {
    color: var(--mm-crit);
}

.rps-result-score {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--mm-gold);
    margin-top: 6px;
}

.rps-result-line {
    font-size: 16px;
    color: var(--mm-ink);
    margin-top: 10px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.rps-selected {
    border-width: 3px;
    border-color: var(--mm-ink);
}

.rps-triangle {
    width: 210px;
    height: 176px;
    margin-bottom: 6px;
    flex-shrink: 0;
    --tri-horns: var(--mm-teal);
    --tri-wings: var(--mm-plum);
    --tri-back: var(--mm-gold);
    --tri-ink: var(--mm-ink-soft);
    --tri-hi: var(--mm-coral);
    --tri-fill: var(--mm-surface-2);
}

.rps-triangle__label {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--mm-ink);
    -unity-text-align: middle-center;
}

.rps-action {
    transition-property: scale, background-color;
    transition-duration: 120ms, 120ms;
    transition-timing-function: ease-out, ease-out;
}

.rps-action--selected {
    scale: 1.06 1.06;
}

.rps-card {
    transition-property: scale, border-color, background-color;
    transition-duration: 140ms, 140ms, 140ms;
    transition-timing-function: ease-out, ease-out, ease-out;
}

.rps-card--selected {
    scale: 1.04 1.04;
}

.rps-pip {
    transition-property: scale, background-color, border-color;
    transition-duration: 240ms, 240ms, 240ms;
    transition-timing-function: ease-out-back, ease-out, ease-out;
}

.rps-pip--hit {
    scale: 1.18 1.18;
}

.rps-log {
    transition-property: color;
    transition-duration: 350ms;
}

.rps-log--flash {
    color: var(--mm-coral);
}

.rps-result {
    transition-property: scale, opacity;
    transition-duration: 280ms, 280ms;
    transition-timing-function: ease-out-back, ease-out;
}

.rps-result--enter {
    scale: 0.88 0.88;
    opacity: 0;
}
