/* Combat panel (UI Toolkit) — modal, 4 tabs:
   Batalla Online · Resultados · Historial · Equipo 3v3. Mirrors the breeding panel chrome. */

.cbt-backdrop {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.cbt-window {
    width: 90%;
    height: 88%;
    padding: 14px;
    border-radius: 12px;
    background-color: rgb(28, 28, 38);
}

/* Header */
.cbt-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.cbt-title {
    flex-grow: 1;
    height: 52px;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 24px 42px;
    -unity-font-style: bold;
    color: rgb(235, 235, 240);
}

.cbt-close {
    width: 36px; height: 36px;
    margin: 0; border-radius: 6px;
    -unity-font-style: bold; font-size: 18px;
    color: rgb(235, 235, 240);
    background-color: rgb(70, 70, 88);
}
.cbt-close:hover { background-color: rgb(95, 95, 120); }

/* TabView (centered headers, pills, no scroll arrows) */
.cbt-tabs { flex-grow: 1; }

.cbt-tabs > .unity-tab-view__header-container {
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;
    background-color: rgb(22, 22, 30);
    border-radius: 8px;
    padding: 4px;
    margin-bottom: 10px;
}

.cbt-tabs .unity-scroller--horizontal,
.cbt-tabs .unity-tab-view__header-container .unity-scroller { display: none; }

.unity-tab__header {
    padding-left: 22px; padding-right: 22px;
    padding-top: 8px; padding-bottom: 8px;
    margin-right: 6px; border-radius: 6px;
    background-color: rgb(40, 40, 52);
}
.unity-tab__header:hover { background-color: rgb(58, 58, 76); }
.unity-tab__header:checked { background-color: rgb(150, 80, 80); }
.unity-tab__header-label { font-size: 18px; -unity-font-style: bold; color: rgb(225, 225, 232); }
.unity-tab__header-underline { display: none; }

.cbt-tabs .unity-tab-view__content-container,
.cbt-tabs .unity-tab,
.cbt-tabs .unity-tab__content-container { flex-grow: 1; }

/* ── Body / columns ── */
.cbt-body { flex-direction: row; flex-grow: 1; }

.cbt-col-side {
    width: 27%;
    background-color: rgb(24, 24, 32);
    border-radius: 10px;
    padding: 8px;
}

.cbt-col-center {
    flex-grow: 1;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
}

.cbt-col-title {
    font-size: 16px; -unity-font-style: bold;
    color: rgb(170, 170, 185);
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}

.cbt-placeholder {
    flex-grow: 1;
    font-size: 16px; color: rgb(120, 120, 135);
    -unity-text-align: middle-center;
}

/* ── Lists ── */
.cbt-list { flex-grow: 1; }

.cbt-candidate {
    padding: 8px; margin-bottom: 6px; border-radius: 8px;
    background-color: rgb(40, 40, 52);
    border-width: 3px; border-color: rgba(0, 0, 0, 0);
}
.cbt-candidate:hover { background-color: rgb(54, 54, 70); }
.cbt-candidate-text { font-size: 14px; color: rgb(228, 228, 234); white-space: normal; }

/* ── Tab 1 center (selected creature) ── */
.cbt-portrait {
    width: 150px; height: 150px;
    border-radius: 10px;
    background-color: rgb(60, 60, 72);
    margin-top: 6px; margin-bottom: 8px;
}
.cbt-name {
    width: 100%;
    font-size: 22px; -unity-font-style: bold; color: rgb(235, 235, 240);
    -unity-text-align: middle-center;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    margin-bottom: 4px;
}
.cbt-stats { font-size: 16px; -unity-font-style: bold; color: rgb(205, 205, 215); margin-bottom: 8px; }

.cbt-parts { width: 100%; align-items: center; margin-bottom: 10px; }
.cbt-part-row { flex-direction: row; align-items: center; margin-bottom: 3px; }
.cbt-swatch { width: 16px; height: 16px; border-radius: 4px; margin-right: 6px; }
.cbt-part-text { font-size: 13px; color: rgb(220, 220, 228); white-space: normal; }

.cbt-actions { flex-direction: row; margin-top: 6px; }

.cbt-action {
    padding-top: 10px; padding-bottom: 10px;
    padding-left: 16px; padding-right: 16px;
    margin: 4px; border-radius: 8px;
    font-size: 16px; -unity-font-style: bold;
    color: rgb(245, 240, 245);
    border-width: 3px; border-color: rgba(0, 0, 0, 0);
}
.cbt-action--instant { background-color: rgb(210, 120, 60); }
.cbt-action--instant:hover { background-color: rgb(230, 140, 80); }
.cbt-action--timer { background-color: rgb(150, 90, 190); }
.cbt-action--timer:hover { background-color: rgb(170, 110, 210); }
.cbt-action--fight { background-color: rgb(200, 70, 70); min-width: 200px; }
.cbt-action--fight:hover { background-color: rgb(220, 90, 90); }
.cbt-action--refresh { background-color: rgb(70, 130, 180); margin-bottom: 8px; }
.cbt-action--refresh:hover { background-color: rgb(90, 150, 200); }

.cbt-action--busy,
.cbt-action--busy:hover { background-color: rgb(90, 90, 100); color: rgb(180, 180, 185); }

.cbt-vs { font-size: 28px; -unity-font-style: bold; color: rgb(220, 120, 120); margin-left: 14px; margin-right: 14px; }

.cbt-log-line { font-size: 13px; color: rgb(210, 210, 218); white-space: normal; margin-bottom: 2px; }

/* ── Tab 3 results ── */
.cbt-col-results {
    width: 34%;
    background-color: rgb(24, 24, 32);
    border-radius: 10px; padding: 8px;
}

.cbt-result-row {
    flex-direction: row; justify-content: space-between; align-items: center;
    padding: 9px; margin-bottom: 6px; border-radius: 8px;
    background-color: rgb(40, 40, 52);
    border-width: 3px; border-color: rgba(0, 0, 0, 0);
}
.cbt-result-row:hover { background-color: rgb(54, 54, 70); }
.cbt-result-name { flex-grow: 1; font-size: 15px; -unity-font-style: bold; color: rgb(232, 232, 238); white-space: normal; }
.cbt-result-status { font-size: 13px; color: rgb(175, 175, 190); margin-left: 8px; }

.cbt-col-log {
    flex-grow: 1; margin-left: 12px;
    background-color: rgb(20, 20, 28);
    border-radius: 10px; padding: 12px;
}
.cbt-log-opponent { font-size: 20px; -unity-font-style: bold; color: rgb(225, 225, 235); margin-bottom: 8px; white-space: normal; }
.cbt-log-lines { flex-grow: 1; }
.cbt-log-outcome {
    font-size: 34px; -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(220, 220, 225);
    margin-top: 10px;
}
.cbt-log-outcome--win  { color: rgb(110, 220, 120); }
.cbt-log-outcome--lose { color: rgb(235, 110, 100); }

.cbt-replay-btn {
    align-self: flex-end;
    margin-top: 8px;
    padding-top: 6px; padding-bottom: 6px;
    padding-left: 14px; padding-right: 14px;
    border-radius: 8px;
    font-size: 14px; -unity-font-style: bold;
    color: rgb(245, 240, 245);
    background-color: rgb(70, 130, 180);
    border-width: 3px; border-color: rgba(0, 0, 0, 0);
}
.cbt-replay-btn:hover { background-color: rgb(90, 150, 200); }
.cbt-replay-btn:disabled { background-color: rgb(90, 90, 100); color: rgb(180, 180, 185); }

/* ── Tab 3 results: queue + local clock ── */
.cbt-results-body { justify-content: center; }

.cbt-results-center {
    width: 50%;
    flex-grow: 0;
    align-self: center;
    align-items: center;
    background-color: rgb(24, 24, 32);
    border-radius: 10px;
    padding: 16px;
}

.cbt-clock-caption { font-size: 15px; color: rgb(170, 170, 185); margin-top: 4px; }
.cbt-clock {
    font-size: 56px; -unity-font-style: bold;
    color: rgb(230, 200, 120);
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.cbt-queue-list { width: 100%; }

.cbt-result-queued { font-size: 12px; color: rgb(150, 150, 165); margin-left: 8px; }
.cbt-result-time { font-size: 14px; -unity-font-style: bold; color: rgb(230, 200, 120); margin-left: 8px; }

/* ── Tab 4 history ── */
.cbt-filter { margin-bottom: 8px; }

.cbt-hist-date { font-size: 14px; color: rgb(160, 160, 175); margin-bottom: 8px; }

.cbt-hist-meta { font-size: 12px; color: rgb(160, 160, 175); margin-left: 8px; }

.cbt-result-status--win  { color: rgb(110, 220, 120); }
.cbt-result-status--lose { color: rgb(235, 110, 100); }
.cbt-result-status--draw { color: rgb(200, 200, 130); }

/* Focus ring (keyboard/gamepad) */
.cbt-focus { border-color: rgb(150, 120, 230); }
.cbt-tabs.tabbar-focused > .unity-tab-view__header-container {
    border-width: 2px; border-color: rgb(150, 120, 230);
}

/* ── Tab 5: Equipo 3v3 (lineup) ── */
.cbt-lu-root { flex-grow: 1; height: 100%; flex-direction: column; }

.cbt-lu-main { flex-direction: row; flex-grow: 1; align-items: stretch; }

.cbt-lu-center { flex-grow: 1; flex-direction: column; align-items: center; }

.cbt-lu-roster-wrap {
    width: 20%;
    flex-direction: column;
    align-items: stretch;
    padding: 6px;
}

.cbt-lu-roster { flex-grow: 1; flex-direction: column; justify-content: flex-start; }

.cbt-lu-roster-card {
    margin-bottom: 8px;
    border-radius: 10px;
    padding: 12px;
    background-color: rgb(40, 40, 52);
    border-width: 3px; border-color: rgba(0, 0, 0, 0);
    min-height: 168px;
    justify-content: center;
}
.cbt-lu-roster-card--empty {
    background-color: rgb(30, 30, 40);
    border-color: rgba(120, 100, 220, 0.35);
    justify-content: center; align-items: center;
}

.cbt-lu-roster-name {
    font-size: 20px; -unity-font-style: bold; color: rgb(245, 245, 250);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.cbt-lu-roster-meta { flex-direction: row; align-items: center; margin-top: 8px; }
.cbt-lu-roster-stats { font-size: 16px; color: rgb(205, 205, 215); margin-top: 12px; }

.cbt-lu-actions { flex-direction: row; margin-bottom: 10px; }

.cbt-lu-battlefield {
    width: 100%;
    flex-direction: row;
    align-items: center; justify-content: center;
    flex-grow: 1;
}

.cbt-lu-team { flex-direction: column; align-items: center; }

.cbt-lu-board { flex-direction: row; align-items: center; }

.cbt-lu-col { flex-direction: column; justify-content: center; }

.cbt-lu-slot {
    width: 104px; height: 104px; margin: 5px;
    border-radius: 12px;
    background-color: rgb(40, 40, 52);
    border-width: 3px; border-color: rgba(0, 0, 0, 0);
    align-items: center; justify-content: center;
    overflow: hidden;
}
.cbt-lu-slot--front { border-color: rgba(210, 100, 100, 0.45); }
.cbt-lu-slot--mid   { border-color: rgba(150, 150, 160, 0.3); }
.cbt-lu-slot--back  { border-color: rgba(100, 140, 210, 0.45); }
.cbt-lu-slot--hover  { border-color: rgb(120, 220, 130); }
.cbt-lu-slot--reject { border-color: rgb(220, 90, 90); }

.cbt-lu-slot-row { font-size: 10px; color: rgb(140, 140, 155); -unity-text-align: middle-center; }

.cbt-lu-unit {
    width: 100%; height: 100%;
    border-radius: 9px;
    align-items: center; justify-content: space-between;
    padding: 4px;
}
.cbt-lu-unit-name {
    font-size: 12px; -unity-font-style: bold; color: rgb(245, 245, 250);
    -unity-text-align: middle-center;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    width: 100%;
}

.cbt-lu-role {
    padding-top: 2px; padding-bottom: 2px; padding-left: 8px; padding-right: 8px;
    border-radius: 8px;
    font-size: 12px; -unity-font-style: bold; color: rgb(245, 245, 250);
}
.cbt-lu-role--protector { background-color: rgb(80, 130, 220); }
.cbt-lu-role--agresivo  { background-color: rgb(210, 80, 80); }
.cbt-lu-role--empatico  { background-color: rgb(90, 190, 120); }

.cbt-lu-elem {
    padding-top: 2px; padding-bottom: 2px; padding-left: 8px; padding-right: 8px;
    border-radius: 8px;
    font-size: 12px; -unity-font-style: bold;
    background-color: rgb(70, 70, 88); color: rgb(170, 170, 185);
    margin-left: 6px;
}

.cbt-lu-count { font-size: 14px; -unity-font-style: bold; color: rgb(205, 205, 215); margin-top: 4px; }

.cbt-lu-hint { font-size: 14px; color: rgb(120, 120, 135); margin-top: 4px; margin-bottom: 4px; }

.cbt-lu-ghost {
    position: absolute;
    width: 104px; height: 104px;
    border-radius: 12px;
    opacity: 0.85;
    align-items: center; justify-content: center;
}

.cbt-lu-swatch { width: 28px; height: 28px; border-radius: 6px; margin-right: 10px; }

.cbt-lu-name-row { flex-direction: row; align-items: center; justify-content: space-between; }
.cbt-lu-fights {
    font-size: 14px; -unity-font-style: bold;
    color: rgb(230, 200, 120);
    margin-left: 8px;
    flex-shrink: 0;
}

.cbt-lu-dragging { opacity: 0.35; }

/* ── Carousel (selection pool) ── */
.cbt-lu-carousel {
    height: 214px;
    flex-shrink: 0;
    margin-top: auto;
    background-color: rgb(24, 24, 32);
    border-radius: 10px;
    padding: 8px;
}
.cbt-lu-carousel .unity-scroller--vertical { display: none; }

.cbt-lu-carousel .unity-scroller--horizontal { height: 8px; }
.cbt-lu-carousel .unity-scroller--horizontal .unity-scroller__low-button,
.cbt-lu-carousel .unity-scroller--horizontal .unity-scroller__high-button { display: none; }
.cbt-lu-carousel .unity-scroller--horizontal .unity-base-slider__tracker { background-color: rgb(20, 20, 28); border-width: 0; border-radius: 4px; }
.cbt-lu-carousel .unity-scroller--horizontal .unity-base-slider__dragger { background-color: rgb(70, 70, 88); border-width: 0; border-radius: 4px; height: 8px; }
.cbt-lu-carousel .unity-scroller--horizontal .unity-base-slider { margin: 0; }

.cbt-lu-card {
    width: 316px; height: 184px; flex-shrink: 0;
    margin-right: 10px;
    border-radius: 10px;
    padding: 14px;
    background-color: rgb(40, 40, 52);
    border-width: 3px; border-color: rgba(0, 0, 0, 0);
    overflow: hidden;
}
.cbt-lu-card:hover { background-color: rgb(54, 54, 70); }

.cbt-lu-card-top { flex-direction: row; align-items: center; }
.cbt-lu-card-name {
    font-size: 19px; -unity-font-style: bold; color: rgb(245, 245, 250);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}
.cbt-lu-card-chips { flex-direction: row; margin-top: 12px; }

/* ── Detail overlay ── */
.cbt-lu-detail-backdrop {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center; justify-content: center;
    display: none;
}

.cbt-lu-detail {
    width: 46%;
    background-color: rgb(28, 28, 38);
    border-radius: 12px;
    padding: 14px;
}

.cbt-lu-detail-header {
    flex-direction: row; justify-content: space-between; align-items: center;
    margin-bottom: 6px;
}
.cbt-lu-detail-name { font-size: 22px; -unity-font-style: bold; color: rgb(235, 235, 240); }

.cbt-lu-detail-chips { flex-direction: row; margin-bottom: 10px; }

.cbt-lu-detail-body { flex-direction: row; }

.cbt-lu-detail-stats { width: 50%; padding-right: 10px; }
.cbt-lu-detail-equip {
    flex-grow: 1;
    background-color: rgb(20, 20, 28);
    border-radius: 8px;
    padding: 8px;
}

.cbt-lu-stat-row { flex-direction: row; justify-content: space-between; margin-bottom: 3px; }
.cbt-lu-stat-name { font-size: 13px; color: rgb(170, 170, 185); }
.cbt-lu-stat-val { font-size: 13px; -unity-font-style: bold; color: rgb(235, 235, 240); }
.cbt-lu-stat-val--buff { color: rgb(110, 220, 120); }

.cbt-lu-equip-row { flex-direction: row; align-items: center; margin-bottom: 4px; }
.cbt-lu-equip-slot { font-size: 11px; color: rgb(150, 150, 165); width: 64px; }
.cbt-lu-equip-name { font-size: 12px; color: rgb(220, 220, 228); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.cbt-lu-result-outcome { font-size: 26px; -unity-font-style: bold; color: rgb(235, 235, 240); }
.cbt-lu-result-outcome--a { color: rgb(110, 220, 120); }
.cbt-lu-result-outcome--b { color: rgb(235, 110, 100); }

.cbt-lu-result-sub { font-size: 14px; color: rgb(205, 205, 215); margin-bottom: 8px; }

.cbt-lu-result-log { height: 320px; background-color: rgb(20, 20, 28); border-radius: 8px; padding: 8px; }
