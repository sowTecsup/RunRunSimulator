/* Breeding panel (UI Toolkit) — modal, big, 3 columns.
   Left/right parent lists are ALWAYS present; the TabView sits centered in the
   middle column and only swaps the center content (Criar / Incubando). */

.breed-backdrop {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.breed-window {
    width: 90%;
    height: 88%;
    padding: 14px;
    border-radius: 12px;
    background-color: rgb(28, 28, 38);
}

/* Header */
.breed-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.breed-title {
    flex-grow: 1;
    height: 52px;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 24px 42px;
    -unity-font-style: bold;
    color: rgb(235, 235, 240);
}

.breed-close {
    width: 36px; height: 36px;
    margin: 0;
    border-radius: 6px;
    -unity-font-style: bold;
    font-size: 18px;
    color: rgb(235, 235, 240);
    background-color: rgb(70, 70, 88);
}

.breed-close:hover { background-color: rgb(95, 95, 120); }

/* ── 3-column body ── */
.breed-body {
    flex-direction: row;
    flex-grow: 1;
}

.breed-col-side {
    width: 27%;
    background-color: rgb(24, 24, 32);
    border-radius: 10px;
    padding: 8px;
}

.breed-col-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(170, 170, 185);
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}

.breed-col-center {
    flex-grow: 1;
    padding-left: 12px;
    padding-right: 12px;
}

/* ── TabView (centered headers, pills, no scroll arrows) ── */
.breed-tabs { flex-grow: 1; }

.breed-tabs > .unity-tab-view__header-container {
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;   /* tabs centered over the middle column */
    background-color: rgb(22, 22, 30);
    border-radius: 8px;
    padding: 4px;
    margin-bottom: 10px;
}

.breed-tabs .unity-scroller--horizontal,
.breed-tabs .unity-tab-view__header-container .unity-scroller {
    display: none;
}

.unity-tab__header {
    padding-left: 22px; padding-right: 22px;
    padding-top: 8px; padding-bottom: 8px;
    margin-right: 6px;
    border-radius: 6px;
    background-color: rgb(40, 40, 52);
}

.unity-tab__header:hover { background-color: rgb(58, 58, 76); }
.unity-tab__header:checked { background-color: rgb(150, 90, 120); }
.unity-tab__header-label { font-size: 18px; -unity-font-style: bold; color: rgb(225, 225, 232); }
.unity-tab__header-underline { display: none; }

.breed-tabs .unity-tab-view__content-container,
.breed-tabs .unity-tab__content-container { flex-grow: 1; }

/* ── Criar center content ── */
.criar-content {
    flex-grow: 1;
    align-items: center;
}

.breed-slots {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
    margin-bottom: 10px;
}

.breed-slot {
    width: 42%;
    height: 210px;
    flex-shrink: 0;          /* keep a stable size regardless of the name length */
    overflow: hidden;        /* clip a long name instead of growing the box */
    align-items: center;
    justify-content: flex-start;
    padding: 10px;
    border-radius: 10px;
    background-color: rgb(40, 40, 52);
    /* transparent 3px border reserved for the focus ring (no reflow) */
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0);
}

.breed-slot:hover { background-color: rgb(54, 54, 70); }
.breed-slot-role { font-size: 14px; color: rgb(170, 170, 185); margin-bottom: 6px; }

/* Square portrait placeholder (tinted with the parent's PrimaryColor in code). */
.breed-slot-img {
    width: 120px;
    height: 120px;
    border-radius: 8px;
    background-color: rgb(60, 60, 72);
    margin-bottom: 8px;
}

/* Name stays on ONE line; overflow is ellipsized so it never resizes the slot. */
.breed-slot-name {
    width: 100%;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(235, 235, 240);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.breed-heart { font-size: 36px; margin-left: 16px; margin-right: 16px; }

.breed-egg { align-items: center; margin-top: 14px; }
.breed-egg-icon { font-size: 48px; color: rgb(200, 200, 210); }
.breed-time { font-size: 16px; color: rgb(180, 180, 195); margin-top: 4px; }

.breed-action {
    min-width: 220px;
    margin-top: 14px;
    padding-top: 10px; padding-bottom: 10px;
    border-radius: 8px;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(245, 240, 245);
    background-color: rgb(190, 90, 130);
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0);
}

.breed-action:hover { background-color: rgb(210, 110, 150); }

/* Breed in flight — grayed + non-interactive until the async update lands. */
.breed-action--busy,
.breed-action--busy:hover {
    background-color: rgb(90, 90, 100);
    color: rgb(180, 180, 185);
}

/* Both-parents preview fills the remaining lower space. */
.breed-preview {
    flex-direction: row;
    width: 100%;
    flex-grow: 1;
    margin-top: 16px;
}

.preview-parent {
    flex-grow: 1;
    width: 50%;
    padding: 10px;
    margin: 4px;
    border-radius: 8px;
    background-color: rgb(34, 34, 46);
}

.preview-name { font-size: 18px; -unity-font-style: bold; color: rgb(235, 235, 240); margin-bottom: 4px; white-space: normal; }
.preview-stats { font-size: 15px; -unity-font-style: bold; color: rgb(200, 200, 210); margin-bottom: 6px; }
.preview-part-row { flex-direction: row; align-items: center; margin-bottom: 3px; }
.preview-swatch { width: 16px; height: 16px; border-radius: 4px; margin-right: 6px; }
.preview-part-text { flex-grow: 1; font-size: 13px; color: rgb(220, 220, 228); white-space: normal; }

/* ── Side lists (always visible) ── */
.breed-list { flex-grow: 1; }

.breed-candidate {
    padding: 8px;
    margin-bottom: 6px;
    border-radius: 8px;
    background-color: rgb(40, 40, 52);
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0);
}

.breed-candidate:hover { background-color: rgb(54, 54, 70); }
.breed-candidate-text { font-size: 14px; color: rgb(228, 228, 234); white-space: normal; }

/* ── Incubando tab: egg list ── */
.egg-list { flex-grow: 1; }

.egg-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 10px;
    margin-bottom: 8px;
    border-radius: 8px;
    background-color: rgb(40, 40, 52);
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0);
}

.egg-pair { flex-grow: 1; font-size: 17px; -unity-font-style: bold; color: rgb(235, 235, 240); white-space: normal; }
.egg-time { font-size: 16px; color: rgb(180, 180, 195); margin-left: 10px; margin-right: 10px; }

.egg-hatch {
    min-width: 110px;
    padding-top: 8px; padding-bottom: 8px;
    border-radius: 6px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(30, 30, 30);
    background-color: rgb(245, 215, 90);
}

.egg-hatch:hover { background-color: rgb(255, 230, 120); }

/* Hatch in flight — grayed out + non-interactive until the server answers.
   The :hover variant keeps it gray (otherwise the base :hover repaints it yellow). */
.egg-hatch--busy,
.egg-hatch--busy:hover {
    background-color: rgb(90, 90, 100);
    color: rgb(180, 180, 185);
}

/* Focus ring (keyboard/gamepad) — toggled by the controller on the focused element. */
.breed-focus { border-color: rgb(150, 120, 230); }

/* Tab bar focused (region == TabBar) — outline the header so A/D feels intentional. */
.breed-tabs.tabbar-focused > .unity-tab-view__header-container {
    border-width: 2px;
    border-color: rgb(150, 120, 230);
}
