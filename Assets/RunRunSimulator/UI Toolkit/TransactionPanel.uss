.tx-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--mm-scrim);
}

.panel {
    width: 640px;
    max-width: 92%;
    background-color: var(--mm-surface);
    border-width: 2px;
    border-color: var(--mm-plum);
    border-radius: 16px;
}

.panel__header {
    background-color: var(--mm-surface-2);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    padding: 10px 16px;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--mm-frame-soft);
}
.panel__title {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--mm-gold);
    letter-spacing: 4px;
}

.top-row { flex-direction: row; padding: 20px 16px; }

.col { flex-grow: 1; flex-basis: 0; align-items: center; }
.col__label {
    font-size: 11px;
    color: var(--mm-ink-soft);
    letter-spacing: 2px;
    margin-bottom: 12px;
}

.divider {
    width: 1px;
    background-color: var(--mm-frame-soft);
    margin: 4px 12px;
}

.customer-name { font-size: 19px; -unity-font-style: bold; color: var(--mm-ink); }
.archetype {
    font-size: 12px;
    color: var(--mm-plum);
    background-color: var(--mm-surface-2);
    border-radius: 8px;
    padding: 3px 10px;
    margin-top: 8px;
}

.mm-swatch {
    width: 64px;
    height: 64px;
    border-radius: 14px;
    background-color: rgb(120, 120, 120);
    border-width: 3px;
    border-color: var(--mm-frame-soft);
}
.target-name { font-size: 16px; -unity-font-style: bold; color: var(--mm-ink); margin-top: 10px; }
.target-info {
    font-size: 12px;
    color: var(--mm-teal);
    background-color: var(--mm-surface-2);
    border-radius: 8px;
    padding: 2px 9px;
    margin-top: 6px;
}

.price-tag {
    align-items: center;
    background-color: var(--mm-surface-2);
    border-width: 2px;
    border-color: var(--mm-good);
    border-radius: 12px;
    padding: 10px 20px;
}
.offer { font-size: 30px; -unity-font-style: bold; color: var(--mm-good); }
.offer-unit { font-size: 11px; color: var(--mm-ink-soft); letter-spacing: 1px; margin-top: 2px; }

.actions { flex-direction: row; padding: 0 16px 18px 16px; }
.action {
    flex-grow: 1;
    flex-basis: 0;
    height: 42px;
    margin-right: 10px;
    border-radius: 10px;
    border-width: 0;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(245, 245, 248);
}
.action--more { margin-right: 0; }

.action--cancel { background-color: var(--mm-crit); }
.action--cancel:hover { background-color: var(--mm-crit); }
.action--accept { background-color: var(--mm-good); }
.action--accept:hover { background-color: var(--mm-good); }
.action--more { background-color: var(--mm-gold); }
.action--more:hover { background-color: var(--mm-gold); }

.action:disabled { opacity: 0.40; }
