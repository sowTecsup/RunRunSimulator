/* Grid layout for the MoriMonchis panel (UI Toolkit).
   Colors come from Theme.uss tokens (mm-theme on the root) — "El Diario del Pet Shop".
   - 10% inset from every screen edge, always (responsive).
   - Cards are a wrapping flex row; their size is driven from C# (cardSize).
   - Vertical scroll kicks in automatically when the cards overflow. */

.grid-root {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 10%;
    bottom: 10%;
    padding: 14px;
    background-color: var(--mm-surface);
    border-width: 3px;
    border-color: var(--mm-frame);
    border-radius: 22px;
}

.grid-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.grid-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--mm-ink);
}

.grid-close {
    width: 36px;
    height: 36px;
    margin: 0;
    border-radius: 10px;
    border-width: 3px;
    border-color: var(--mm-frame);
    -unity-font-style: bold;
    font-size: 18px;
    color: var(--mm-ink);
    background-color: var(--mm-surface-2);
}

.grid-close:hover {
    background-color: var(--mm-coral);
    color: rgb(255, 255, 255);
}

.grid-container {
    flex-grow: 1;
}

.grid-container .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

/* One card = one MoriMochi. width/height come from C# (cardSize). Warm paper card
   with an inked border; slightly rounded like a taped-in photo. */
.card {
    margin: 6px;
    padding: 5px;
    border-radius: 14px;
    background-color: var(--mm-surface-2);
    align-items: center;
    border-width: 3px;
    border-color: var(--mm-frame-soft);
}

.card:hover {
    background-color: var(--mm-surface);
    border-color: var(--mm-coral);
}

.card--selected {
    border-color: var(--mm-coral);
    background-color: var(--mm-surface);
}

.card__name {
    height: 20%;
    width: 100%;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 8px 22px;
    -unity-font-style: bold;
    color: var(--mm-ink);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Middle 60% — portrait. Framed like a photo; tinted with the creature color from
   code until the live 3D render / pixel frame lands. */
.card__icon {
    height: 60%;
    width: 80%;
    border-radius: 8px;
    border-width: 2px;
    border-color: var(--mm-frame-soft);
    background-color: rgb(120, 120, 120);
}

.card__state {
    height: 20%;
    width: 100%;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 6px 22px;
    color: var(--mm-ink-soft);
    -unity-text-align: middle-center;
}

.card__equip-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 2px;
}

.card__equip-slot {
    width: 22px;
    height: 22px;
    margin: 1px;
    border-width: 2px;
    border-color: var(--mm-frame-soft);
    border-radius: 6px;
    background-color: var(--mm-surface);
}

.card__equip-slot--empty {
    opacity: 0.35;
}
