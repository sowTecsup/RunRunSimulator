.npc-tag {
    align-items: center;
    align-self: center;
    padding: 6px 12px;
    background-color: var(--mm-surface);
    border-width: 2px;
    border-color: var(--mm-frame);
    border-radius: 10px;
}

.npc-tag__name {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--mm-ink);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.npc-tag__thought {
    font-size: 20px;
    color: var(--mm-ink);
    -unity-text-align: middle-center;
    white-space: nowrap;
    margin-top: 2px;
}
