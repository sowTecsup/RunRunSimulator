.hotbar-root {
    position: absolute;
    bottom: 24px;
    left: 0;
    right: 0;
    align-items: center;
    justify-content: center;
}

.hotbar-slots {
    flex-direction: row;
}

.hotbar-slot {
    width: 126px;
    height: 126px;
    margin: 6px;
    background-color: var(--mm-scrim);
    border-width: 2px;
    border-color: var(--mm-frame-soft);
    border-radius: 11px;
    align-items: center;
    justify-content: flex-end;
}

.hotbar-slot--active {
    border-color: var(--mm-coral);
    background-color: var(--mm-surface);
    scale: 1.08 1.08;
}

.hotbar-slot__index {
    position: absolute;
    top: 3px;
    left: 6px;
    font-size: 21px;
    color: var(--mm-ink-soft);
}

.hotbar-slot__name {
    width: 100%;
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: 20px;
    color: var(--mm-ink);
    padding-bottom: 5px;
}
