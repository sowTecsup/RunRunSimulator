.storage-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--mm-scrim);
}

.storage-panel {
    width: 420px;
    max-height: 70%;
    background-color: var(--mm-surface);
    border-width: 3px;
    border-color: var(--mm-frame);
    border-radius: 22px;
    padding: 12px;
}

.storage-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.storage-title {
    font-size: 20px;
    color: var(--mm-gold);
    -unity-font-style: bold;
}

.storage-close {
    width: 28px;
    height: 28px;
    border-radius: 10px;
    border-width: 3px;
    border-color: var(--mm-frame);
    color: var(--mm-ink);
    background-color: var(--mm-surface-2);
}

.storage-close:hover { background-color: var(--mm-coral); color: rgb(255, 255, 255); }

.storage-list {
    flex-grow: 1;
}

.storage-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 6px 8px;
    margin-bottom: 4px;
    background-color: var(--mm-surface-2);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.storage-row--selected {
    border-color: var(--mm-gold);
    background-color: var(--mm-surface);
}

.storage-row__name {
    font-size: 14px;
    color: var(--mm-ink);
}

.storage-row__eject {
    height: 26px;
    min-width: 70px;
    border-radius: 8px;
    border-width: 3px;
    border-color: var(--mm-frame);
    color: rgb(255, 255, 255);
    background-color: var(--mm-coral);
}

.storage-row__eject:hover { background-color: var(--mm-coral-dark); }

.storage-empty {
    color: var(--mm-ink-soft);
    font-size: 13px;
    -unity-text-align: middle-center;
    padding: 16px;
}
