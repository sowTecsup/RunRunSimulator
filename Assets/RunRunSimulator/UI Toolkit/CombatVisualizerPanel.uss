.cv-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
}

.cv-header {
    align-self: center;
    margin-top: 16px;
    padding: 8px 24px;
    background-color: rgba(0, 0, 0, 0.65);
    border-radius: 6px;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
}

.cv-turn {
    font-size: 24px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.cv-spacer {
    flex-grow: 1;
}

.cv-log-frame {
    align-self: stretch;
    margin: 12px;
    padding: 12px 16px;
    background-color: rgba(0, 0, 0, 0.78);
    border-radius: 8px;
    border-width: 3px;
    border-color: rgb(255, 255, 255);
    min-height: 160px;
}

.cv-log {
    flex-direction: column;
}

.log-line {
    color: rgb(255, 255, 255);
    font-size: 18px;
    padding: 2px 0;
    white-space: normal;
}
