.cv-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
}

.cv-turn-box {
    position: absolute;
    right: 1%;
    top: 50%;
    translate: 0 -50%;
    padding: 6px 16px;
    background-color: rgba(0, 0, 0, 0.65);
    border-radius: 6px;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
}

.cv-turn {
    font-size: 18px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.cv-order-bar {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    padding: 4px 8px;
}

.cv-ob-slot {
    flex-direction: column;
    width: 160px;
    flex-shrink: 0;
    margin: 0 3px;
}

.cv-order-card {
    width: 160px;
    flex-shrink: 0;
    flex-direction: column;
    margin: 0 0 6px 0;
    padding: 7px 4px 4px 4px;
    background-color: rgba(0, 0, 0, 0.78);
    border-radius: 6px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.45);
}

.cv-order-card--self {
}

.cv-order-card--opp {
}

.cv-order-card--dead {
    opacity: 0.35;
}

.cv-order-card--active {
    border-color: rgb(255, 210, 74);
    border-width: 4px;
}

.cv-ob-team-banner {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

.cv-ob-team-banner--self {
    background-color: rgb(70, 130, 230);
}

.cv-ob-team-banner--opp {
    background-color: rgb(225, 75, 75);
}


.cv-ob-marks-split {
    flex-direction: row;
    margin-top: 3px;
    min-height: 40px;
}

.cv-ob-marks-col {
    width: 50%;
    flex-direction: column;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: flex-start;
    min-height: 38px;
    padding: 2px 1px;
    border-top-width: 2px;
    overflow: hidden;
}

.cv-ob-marks-col--ally {
    border-top-color: rgb(90, 160, 255);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.25);
}

.cv-ob-marks-col--enemy {
    border-top-color: rgb(255, 107, 107);
}

.cv-ob-mark-chip {
    font-size: 9px;
    height: 16px;
    color: rgb(20, 20, 20);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-overflow: ellipsis;
    overflow: hidden;
    padding: 0 2px;
    margin: 1px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.6);
}

.cv-ob-body-row {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 3px 0;
}

.cv-ob-headshot {
    width: 100%;
    height: 48px;
    min-height: 48px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.06);
    overflow: hidden;
}

.cv-ob-name {
    color: rgb(255, 255, 255);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    flex-shrink: 1;
}

.cv-ob-role-chip {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(20, 20, 20);
    background-color: rgb(210, 210, 210);
    margin-top: 3px;
    padding: 0 3px;
    border-radius: 2px;
    -unity-text-align: middle-center;
}

.cv-ob-role-chip--protector {
    background-color: rgb(127, 178, 229);
    color: rgb(20, 20, 20);
}

.cv-ob-role-chip--agresivo {
    background-color: rgb(229, 138, 127);
    color: rgb(20, 20, 20);
}

.cv-ob-role-chip--empatico {
    background-color: rgb(143, 214, 160);
    color: rgb(20, 20, 20);
}

.cv-ob-affinity-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin: 2px 0;
}

.cv-ob-dot {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    margin: 0 1px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.35);
    background-color: rgba(0, 0, 0, 0.4);
}

.cv-ob-affinity-plus {
    color: rgb(255, 255, 255);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 0 1px;
}

.cv-ob-affinity-equals {
    color: rgb(255, 255, 255);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 0 2px 0 1px;
}

.cv-ob-affinity-element {
    font-size: 9px;
    height: 16px;
    color: rgb(20, 20, 20);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-overflow: ellipsis;
    overflow: hidden;
    padding: 0 3px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.6);
}

.cv-ob-states-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    min-height: 22px;
    margin-top: 3px;
    overflow: hidden;
}

.cv-ob-state-chip {
    font-size: 15px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    padding: 4px 9px;
    margin: 2px;
    border-radius: 5px;
    border-width: 1px;
    background-color: rgba(255, 255, 255, 0.08);
}

.cv-ob-state-chip--positive {
    background-color: rgba(70, 120, 210, 0.9);
    border-color: rgb(130, 180, 255);
}

.cv-ob-state-chip--negative {
    background-color: rgba(205, 70, 70, 0.9);
    border-color: rgb(255, 125, 125);
}

.cv-ob-tooltip {
    position: absolute;
    max-width: 260px;
    padding: 6px 8px;
    background-color: rgba(15, 15, 15, 0.95);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(255, 255, 255);
}

.cv-ob-tooltip-text {
    color: rgb(240, 240, 240);
    font-size: 11px;
    white-space: normal;
}

.cv-log-frame {
    position: absolute;
    left: 96px;
    right: 0;
    bottom: 0;
    max-height: 34%;
    flex-direction: column;
    padding: 8px 3% 10px 3%;
    background-color: rgba(0, 0, 0, 0.82);
    border-top-width: 3px;
    border-top-color: rgb(255, 255, 255);
}

.cv-log-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    margin-bottom: 4px;
}

.cv-log-title {
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
}

.cv-btn-log-toggle {
    min-width: 28px;
    height: 24px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgba(40, 40, 40, 0.95);
    border-width: 1px;
    border-color: rgb(255, 255, 255);
    border-radius: 4px;
}

.cv-btn-log-toggle:hover {
    background-color: rgba(80, 80, 80, 0.95);
}

.cv-log-scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

.cv-log {
    flex-direction: column;
}

.log-card {
    flex-direction: row;
    align-items: center;
    margin: 3px 2px;
    padding: 6px 10px;
    border-radius: 6px;
    border-left-width: 5px;
    border-left-color: rgb(200, 200, 200);
    background-color: rgba(255, 255, 255, 0.06);
    gap: 8px;
}

.log-headshot {
    width: 64px;
    height: 28px;
    flex-shrink: 0;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.06);
    overflow: hidden;
}

.log-text {
    color: rgb(245, 245, 245);
    font-size: 16px;
    white-space: normal;
    flex-grow: 1;
}

.log-versus {
    background-color: rgba(38, 78, 150, 0.55);
    border-left-color: rgb(106, 160, 255);
}

.log-versus .log-text {
    -unity-font-style: bold;
    font-size: 18px;
    -unity-text-align: middle-center;
}

.log-hit {
    background-color: rgba(70, 70, 70, 0.55);
    border-left-color: rgb(200, 200, 200);
}

.log-crit {
    background-color: rgba(150, 70, 12, 0.6);
    border-left-color: rgb(255, 155, 61);
}

.log-crit .log-text {
    color: rgb(255, 205, 130);
    -unity-font-style: bold;
}

.log-death {
    background-color: rgba(140, 24, 24, 0.6);
    border-left-color: rgb(255, 90, 90);
}

.log-death .log-text {
    color: rgb(255, 175, 175);
    -unity-font-style: bold;
}

.log-result {
    background-color: rgba(150, 120, 20, 0.6);
    border-left-color: rgb(255, 210, 74);
}

.log-result .log-text {
    color: rgb(255, 230, 150);
    -unity-font-style: bold;
    font-size: 18px;
    -unity-text-align: middle-center;
}

.cv-controls {
    position: absolute;
    left: 1%;
    top: 50%;
    translate: 0 -50%;
    flex-direction: column;
    align-items: center;
    padding: 6px 8px;
    background-color: rgba(0, 0, 0, 0.78);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
}

.cv-btn {
    min-width: 32px;
    height: 28px;
    margin: 2px 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgba(40, 40, 40, 0.95);
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    border-radius: 6px;
}

.cv-btn:hover {
    background-color: rgba(80, 80, 80, 0.95);
}

.cv-btn:disabled {
    opacity: 0.4;
}

.cv-btn-play {
    background-color: rgba(34, 120, 52, 0.95);
}

.cv-speed {
    flex-direction: column;
    align-items: center;
    margin-top: 6px;
    width: 76px;
}

.cv-speed-label {
    color: rgb(255, 255, 255);
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}

.cv-slider {
    width: 100%;
}
