.hp-root {
    flex-direction: column;
    padding: 6px 8px;
    background-color: rgba(0, 0, 0, 0.72);
    border-radius: 6px;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    min-width: 160px;
}

.hp-name {
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.hp-track {
    height: 12px;
    background-color: rgba(80, 0, 0, 0.85);
    border-width: 1px;
    border-color: rgb(255, 255, 255);
}

.hp-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(72, 220, 86);
}
