.hp-root {
    flex-direction: column;
    padding: 6px 8px;
    background-color: var(--mm-surface);
    border-radius: 8px;
    border-width: 2px;
    border-color: var(--mm-frame);
    min-width: 160px;
}

.hp-name {
    color: var(--mm-ink);
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.hp-track {
    height: 16px;
    background-color: rgba(80, 0, 0, 0.85);
    border-width: 1px;
    border-color: var(--mm-frame);
    justify-content: center;
}

.hp-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(72, 220, 86);
}

.hp-value {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgb(255, 255, 255);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hp-stats {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 4px;
}

.hp-stat {
    font-size: 11px;
    -unity-font-style: bold;
}

.hp-atk {
    color: rgb(255, 180, 120);
}

.hp-spd {
    color: rgb(150, 210, 255);
}
