.plan {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    right: 0;
    flex-direction: row;
    align-items: flex-start;
    justify-content: flex-start;
}

.plan--hidden {
    display: none;
}

.plan-panel {
    width: 440px;
    max-width: 48%;
    margin: 18px;
    border-width: 3px;
    border-color: var(--mm-frame);
    border-radius: 22px;
}

.plan-panel .panel__header {
    border-top-left-radius: 19px;
    border-top-right-radius: 19px;
}

.plan-header {
    align-items: flex-start;
}

.plan-room {
    font-size: 12px;
    color: var(--mm-ink-soft);
    letter-spacing: 1px;
    margin-top: 4px;
}

.result {
    display: none;
    margin: 10px 12px 0 12px;
    padding: 8px 10px;
    border-radius: 12px;
    background-color: var(--mm-surface-2);
    border-width: 2px;
    border-color: var(--mm-frame-soft);
}

.result--show {
    display: flex;
}

.result__title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--mm-ink);
    margin-bottom: 6px;
}

.result__title--win {
    color: var(--mm-good);
}

.result__title--lose {
    color: var(--mm-crit);
}

.result__title--draw {
    color: var(--mm-ink-soft);
}

.result__teams {
    flex-direction: row;
}

.result__team {
    flex-grow: 1;
    flex-basis: 0;
}

.result__team--rival {
    margin-left: 8px;
}

.result__team-title {
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--mm-good);
    margin-bottom: 4px;
}

.result__team-title--rival {
    color: var(--mm-crit);
}

.result-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.result-row__swatch {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--mm-frame-soft);
    margin-right: 6px;
}

.result-row__name {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--mm-ink);
}

.result-row__stats {
    font-size: 9px;
    color: var(--mm-ink-soft);
    white-space: normal;
}

.plan-cast {
    padding: 10px 12px 0 12px;
}

.cast-card {
    flex-direction: column;
    background-color: var(--mm-surface-2);
    border-radius: 14px;
    border-width: 2px;
    border-color: var(--mm-frame-soft);
    padding: 8px 10px;
    margin-bottom: 8px;
}

.cast-card__head {
    flex-direction: row;
    align-items: center;
}

.cast-card__swatch {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--mm-frame-soft);
    margin-right: 10px;
}

.cast-card__name {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--mm-ink);
}

.cast-card__dials {
    font-size: 11px;
    color: var(--mm-ink-soft);
    letter-spacing: 1px;
}

.plan-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.plan-row__label {
    width: 62px;
    font-size: 10px;
    color: var(--mm-ink-soft);
    letter-spacing: 1px;
    -unity-text-align: middle-left;
}

.pill {
    flex-grow: 1;
    flex-basis: 0;
    height: 26px;
    margin: 0 4px 0 0;
    padding: 0;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--mm-frame-soft);
    background-color: var(--mm-surface);
    color: var(--mm-ink);
    font-size: 11px;
    -unity-font-style: bold;
}

.pill:hover {
    border-color: var(--mm-coral);
}

.pill--on {
    background-color: var(--mm-coral);
    border-color: var(--mm-coral-dark);
    color: rgb(255, 250, 244);
}

.pill--site.pill--on {
    background-color: var(--mm-teal);
    border-color: var(--mm-teal);
}

.pill:disabled {
    opacity: 0.35;
}

.plan-tools {
    flex-direction: row;
    padding: 6px 12px 0 12px;
}

.tool {
    flex-grow: 1;
    flex-basis: 0;
    height: 30px;
    margin: 0 6px 0 0;
    padding: 0 4px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--mm-frame-soft);
    background-color: var(--mm-surface-2);
    color: var(--mm-ink);
    font-size: 11px;
    -unity-font-style: bold;
}

.tool--last {
    margin-right: 0;
}

.tool:hover {
    border-color: var(--mm-gold);
}

.plan-rival {
    margin: 8px 16px 0 16px;
    font-size: 12px;
    color: var(--mm-plum);
}

.plan-actions {
    padding-top: 10px;
}

.plan-actions .action {
    margin-right: 0;
}

.picker {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--mm-scrim);
}

.picker--hidden {
    display: none;
}

.picker__panel {
    width: 760px;
    max-width: 90%;
    max-height: 86%;
    border-width: 3px;
    border-color: var(--mm-frame);
    border-radius: 22px;
}

.picker__scroll {
    flex-grow: 1;
    max-height: 520px;
    padding: 10px 12px;
}

.picker__grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.pick-card {
    width: 168px;
    margin: 0 8px 8px 0;
    padding: 8px;
    flex-direction: column;
    align-items: flex-start;
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--mm-frame-soft);
    background-color: var(--mm-surface-2);
}

.pick-card:hover {
    border-color: var(--mm-gold);
}

.pick-card--on {
    border-color: var(--mm-coral-dark);
    background-color: var(--mm-surface);
}

.pick-card__swatch {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    border-width: 2px;
    border-color: var(--mm-frame-soft);
    margin-bottom: 4px;
}

.pick-card__name {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--mm-ink);
}

.pick-card__dials {
    font-size: 9px;
    color: var(--mm-ink-soft);
    letter-spacing: 1px;
    white-space: normal;
}

.picker__footer {
    flex-direction: row;
    align-items: center;
    padding: 6px 16px 16px 16px;
}

.picker__count {
    flex-grow: 1;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--mm-ink);
}

.picker__btn {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: 130px;
    width: 130px;
    margin-right: 10px;
}

.picker__btn--last {
    margin-right: 0;
}
