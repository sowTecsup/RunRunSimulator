.topbar-root {
    position: absolute;
    bottom: 2%;
    left: 1%;
    padding: 0;
}

.topbar-home {
    background-color: var(--mm-surface-2);
    color: var(--mm-ink);
    font-size: 12px;
    -unity-font-style: bold;
    border-width: 2px;
    border-color: var(--mm-frame);
    border-radius: 8px;
    padding: 6px 10px;
}

.topbar-home:hover {
    background-color: var(--mm-surface);
}

.topbar-home:active {
    background-color: rgba(90, 160, 255, 0.9);
}
