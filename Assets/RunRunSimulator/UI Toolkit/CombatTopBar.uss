.topbar-root {
    position: absolute;
    top: 0;
    left: 0;
    padding: 12px;
}

.topbar-home {
    background-color: rgba(0, 0, 0, 0.72);
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    border-radius: 6px;
    padding: 8px 14px;
}

.topbar-home:hover {
    background-color: rgba(50, 50, 50, 0.9);
}

.topbar-home:active {
    background-color: rgba(90, 160, 255, 0.9);
}
