<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="CombatPanelUITKStyle.uss" />
    <ui:VisualElement name="backdrop" class="cbt-backdrop">
        <ui:VisualElement name="window" class="cbt-window">

            <ui:VisualElement class="cbt-header">
                <ui:Label name="title" text="Combate" class="cbt-title" />
                <ui:Button name="close-button" text="X" class="cbt-close" />
            </ui:VisualElement>

            <ui:TabView name="tabs" class="cbt-tabs">

                <!-- ── Tab 1: Batalla Online ── -->
                <ui:Tab label="Batalla Online" name="tab-online">
                    <ui:VisualElement class="cbt-body">

                        <ui:VisualElement class="cbt-col-side">
                            <ui:Label text="Disponibles" class="cbt-col-title" />
                            <ui:ScrollView name="online-list" class="cbt-list" mode="Vertical" />
                        </ui:VisualElement>

                        <ui:VisualElement class="cbt-col-center">
                            <ui:VisualElement name="online-img" class="cbt-portrait" />
                            <ui:Label name="online-name" text="Selecciona un MoriMochi" class="cbt-name" />
                            <ui:Label name="online-stats" text="" class="cbt-stats" />
                            <ui:VisualElement name="online-parts" class="cbt-parts" />
                            <ui:VisualElement class="cbt-actions">
                                <ui:Button name="btn-instant" text="Batalla Instantánea" class="cbt-action cbt-action--instant" />
                                <ui:Button name="btn-timer" text="Encolar (Timer)" class="cbt-action cbt-action--timer" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="cbt-col-side">
                            <ui:Label text="Equipo" class="cbt-col-title" />
                            <ui:Label text="Próximamente" class="cbt-placeholder" />
                        </ui:VisualElement>

                    </ui:VisualElement>
                </ui:Tab>

                <!-- ── Tab 2: Resultados (en cola + reloj al próximo tick) ── -->
                <ui:Tab label="Resultados" name="tab-results">
                    <ui:VisualElement class="cbt-body cbt-results-body">

                        <ui:VisualElement class="cbt-results-center">
                            <ui:Label text="Próximo combate en" class="cbt-clock-caption" />
                            <ui:Label name="queue-clock" text="--:--" class="cbt-clock" />
                            <ui:Button name="btn-refresh" text="Revisar resultados" class="cbt-action cbt-action--refresh" />
                            <ui:ScrollView name="results-list" class="cbt-list cbt-queue-list" mode="Vertical" />
                            <ui:Label name="queue-empty" text="No hay MoriMonchis en cola." class="cbt-placeholder" />
                        </ui:VisualElement>

                    </ui:VisualElement>
                </ui:Tab>

                <!-- ── Tab 3: Historial (todos los combates pasados) ── -->
                <ui:Tab label="Historial" name="tab-history">
                    <ui:VisualElement class="cbt-body">

                        <ui:VisualElement class="cbt-col-results">
                            <ui:DropdownField name="history-filter" class="cbt-filter" />
                            <ui:ScrollView name="history-list" class="cbt-list" mode="Vertical" />
                            <ui:Label name="history-empty" text="Aún no hay combates registrados." class="cbt-placeholder" />
                        </ui:VisualElement>

                        <ui:VisualElement class="cbt-col-log">
                            <ui:Label name="hist-opponent" text="Selecciona un combate" class="cbt-log-opponent" />
                            <ui:Label name="hist-date" text="" class="cbt-hist-date" />
                            <ui:ScrollView name="hist-lines" class="cbt-log-lines" mode="Vertical" />
                            <ui:Label name="hist-outcome" text="" class="cbt-log-outcome" />
                        </ui:VisualElement>

                    </ui:VisualElement>
                </ui:Tab>

                <!-- ── Tab 4: Equipo 3v3 (lineup drag & drop) ── -->
                <ui:Tab label="Equipo 3v3" name="tab-lineup">
                    <ui:VisualElement class="cbt-lu-root">

                        <ui:VisualElement class="cbt-lu-main">
                            <ui:VisualElement class="cbt-lu-roster-wrap">
                                <ui:Label text="Equipo A" class="cbt-col-title" />
                                <ui:VisualElement name="lineup-roster-a" class="cbt-lu-roster" />
                            </ui:VisualElement>

                            <ui:VisualElement class="cbt-lu-center">
                                <ui:VisualElement class="cbt-lu-actions">
                                    <ui:Button name="lineup-auto" text="Auto-armar" class="cbt-action cbt-action--refresh" />
                                    <ui:Button name="lineup-clear" text="Vaciar" class="cbt-action cbt-action--timer" />
                                    <ui:Button name="lineup-fight" text="¡Pelear!" class="cbt-action cbt-action--fight" />
                                </ui:VisualElement>
                                <ui:VisualElement class="cbt-lu-battlefield">
                                    <ui:VisualElement class="cbt-lu-team">
                                        <ui:VisualElement name="lineup-board-a" class="cbt-lu-board" />
                                        <ui:Label name="lineup-count-a" text="0/3" class="cbt-lu-count" />
                                    </ui:VisualElement>
                                    <ui:Label text="VS" class="cbt-vs" />
                                    <ui:VisualElement class="cbt-lu-team">
                                        <ui:VisualElement name="lineup-board-b" class="cbt-lu-board" />
                                        <ui:Label name="lineup-count-b" text="0/3" class="cbt-lu-count" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:Label name="lineup-hint" text="Arrastrá un MoriMochi a un slot" class="cbt-lu-hint" />
                            </ui:VisualElement>

                            <ui:VisualElement class="cbt-lu-roster-wrap">
                                <ui:Label text="Equipo B" class="cbt-col-title" />
                                <ui:VisualElement name="lineup-roster-b" class="cbt-lu-roster" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:ScrollView name="lineup-pool" class="cbt-lu-carousel" mode="Horizontal" />

                        <ui:VisualElement name="lineup-detail" class="cbt-lu-detail-backdrop">
                            <ui:VisualElement class="cbt-lu-detail">
                                <ui:VisualElement class="cbt-lu-detail-header">
                                    <ui:Label name="lineup-detail-name" text="" class="cbt-lu-detail-name" />
                                    <ui:Button name="lineup-detail-close" text="X" class="cbt-close" />
                                </ui:VisualElement>
                                <ui:VisualElement name="lineup-detail-chips" class="cbt-lu-detail-chips" />
                                <ui:VisualElement class="cbt-lu-detail-body">
                                    <ui:VisualElement name="lineup-detail-stats" class="cbt-lu-detail-stats" />
                                    <ui:VisualElement name="lineup-detail-equip" class="cbt-lu-detail-equip" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement name="lineup-result" class="cbt-lu-detail-backdrop">
                            <ui:VisualElement class="cbt-lu-detail">
                                <ui:VisualElement class="cbt-lu-detail-header">
                                    <ui:Label name="lineup-result-outcome" text="" class="cbt-lu-result-outcome" />
                                    <ui:Button name="lineup-result-close" text="X" class="cbt-close" />
                                </ui:VisualElement>
                                <ui:Label name="lineup-result-sub" text="" class="cbt-lu-result-sub" />
                                <ui:ScrollView name="lineup-result-log" class="cbt-lu-result-log" mode="Vertical" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                    </ui:VisualElement>
                </ui:Tab>

            </ui:TabView>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
