/* Equipment backpack popup (tooltip-style): equips items into a MoriMochi's slot
   by clicking or dragging from a 3x3 grid of owned EquipmentSO instances. */

.backpack {
    position: absolute;
    width: 240px;
    padding: 8px;
    border-radius: 14px;
    border-width: 3px;
    border-color: var(--mm-frame);
    background-color: var(--mm-surface);
}

.backpack__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.backpack__tabs {
    flex-direction: row;
    margin-bottom: 4px;
}

.backpack__tab {
    width: 22px;
    height: 22px;
    margin: 0;
    margin-right: 4px;
    padding: 0;
    border-radius: 8px;
    font-size: 11px;
    color: var(--mm-ink-soft);
    background-color: var(--mm-surface-2);
}

.backpack__tab:hover {
    background-color: var(--mm-frame-soft);
}

.backpack__tab--active {
    background-color: var(--mm-plum);
    color: var(--mm-ink);
}

.backpack__grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 204px;
}

.backpack__cell {
    width: 64px;
    height: 64px;
    margin: 2px;
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--mm-frame-soft);
    background-color: var(--mm-surface-2);
    -unity-background-scale-mode: scale-to-fit;
}

.backpack__cell--empty {
    opacity: 0.5;
    border-color: var(--mm-frame-soft);
}

.backpack__cell--none {
    align-items: center;
    justify-content: center;
    border-color: var(--mm-frame);
    background-color: var(--mm-surface-2);
}

.backpack__cell--none:hover {
    border-color: var(--mm-coral);
}

.backpack__cell--none Label {
    font-size: 11px;
    color: var(--mm-ink-soft);
    -unity-text-align: middle-center;
}

.backpack__cell--dragging {
    opacity: 0.4;
}

.backpack__cell--drop-target {
    border-color: rgb(255, 255, 255);
}

.backpack__ghost {
    position: absolute;
    width: 64px;
    height: 64px;
    border-radius: 10px;
    opacity: 0.8;
    background-color: var(--mm-surface-2);
    -unity-background-scale-mode: scale-to-fit;
}

.backpack__name {
    min-height: 16px;
    margin-top: 4px;
    font-size: 12px;
    color: var(--mm-ink);
    white-space: normal;
}
