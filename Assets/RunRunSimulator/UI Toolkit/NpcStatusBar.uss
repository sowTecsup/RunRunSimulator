.status-bar { position: absolute; top: 0; left: 0; right: 0; padding: 8px; flex-direction: row; justify-content: center; }
.npc-list { flex-direction: row; }
.npc-row { flex-direction: row; padding: 4px 12px; margin-right: 8px; background-color: rgba(0,0,0,0.35); border-radius: 4px; }
.npc-name { color: white; -unity-font-style: bold; margin-right: 8px; }
.npc-status { color: rgba(255,255,255,0.85); }
